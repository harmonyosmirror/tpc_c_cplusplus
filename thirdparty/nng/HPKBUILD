pkgname=nng
pkgver=1.11
pkgrel=0
pkgdesc="nanomsg-next-generation - lightweight messaging library"
url="https://nng.nanomsg.org/"
archs=("arm64-v8a" "armeabi-v7a" "x86_64")
license=("MIT")
depends=()
makedepends=()
buildtools=("cmake")

source="https://github.com/nanomsg/$pkgname/archive/refs/tags/v$pkgver.tar.gz"

autounpack=true
downloadpackage=true

builddir=$pkgname-$pkgver
packagename=$pkgname-$pkgver.tar.gz

prepare() {
    mkdir -p $builddir/$ARCH-build
}

build() {
    cd $builddir
    ${OHOS_SDK}/native/build-tools/cmake/bin/cmake "$@" \
        -B$ARCH-build -S./ \
        -DNNG_TESTS=ON
    make -C $ARCH-build -j4
    ret=$?
    cd $OLDPWD
    return $ret
}

package() {
    cd $builddir
    make -C $ARCH-build install
    cd $OLDPWD
}

check() {
    echo "The test must be on an OpenHarmony device!"
}

cleanbuild() {
    rm -rf ${PWD}/$builddir ${PWD}/$pkgname-armeabi-v7a-build ${PWD}/$pkgname-arm64-v8a-build ${PWD}/$pkgname-x86_64-build
}