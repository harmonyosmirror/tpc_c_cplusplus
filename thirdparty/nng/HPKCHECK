source HPKBUILD > /dev/null 2>&1

logfile=${LYCIUM_THIRDPARTY_ROOT}/${pkgname}/${pkgname}_${ARCH}_${OHOS_SDK_VER}_test.log
mkdir -p "$(dirname "${logfile}")"

openharmonycheck() {
    res=0
    if [ -f "${builddir}/${ARCH}-build/CTestTestfile.cmake" ]; then
        cd "${builddir}/${ARCH}-build"
        ctest --output-on-failure --exclude-regex "nng\.multistress|nng\.reqstress" > "${logfile}" 2>&1
        res=$?
        if [ $res -ne 0 ]; then
            mkdir -p ${LYCIUM_FAULT_PATH}/${pkgname}
            cp Testing/Temporary/LastTest.log ${LYCIUM_FAULT_PATH}/${pkgname}/
        fi
        cd "$OLDPWD"
        return $res
    fi

    libdir="${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}/lib"
    incdir="${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}/include"

    echo "N/A native test: no CTest configuration found." > "${logfile}"
    echo "Fallback check: artifact presence validation." >> "${logfile}"

    if [ ! -d "${libdir}" ]; then
        echo "FAIL: missing lib dir: ${libdir}" >> "${logfile}"
        return 1
    fi
    if [ ! -d "${incdir}" ]; then
        echo "FAIL: missing include dir: ${incdir}" >> "${logfile}"
        return 1
    fi

    ls -la "${libdir}" >> "${logfile}" 2>/dev/null || true
    ls -la "${incdir}" >> "${logfile}" 2>/dev/null || true
    echo "PASS: artifact presence check OK" >> "${logfile}"
    return 0
}