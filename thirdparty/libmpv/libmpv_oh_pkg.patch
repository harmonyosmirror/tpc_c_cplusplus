diff --git a/video/out/opengl/context_ohos.c b/video/out/opengl/context_ohos.c
new file mode 100755
index 0000000..47c517a
--- /dev/null
+++ b/video/out/opengl/context_ohos.c
@@ -0,0 +1,248 @@
+/*
+ * OpenHarmony / OHOS: EGL + OHNativeWindow (--wid).
+ * Used with vo=gpu / gpu-next for software-decoded video (CPU → GL textures).
+ *
+ * OHNativeWindow* is supplied by XComponent (same as ohos_avcodec_embed).
+ */
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+
+#include <native_window/external_window.h>
+
+/* NativeWindowOperation codes (fallback if header only typedefs enum). */
+#ifndef GET_BUFFER_GEOMETRY
+enum {
+    MPV_OHOS_NW_SET_BUFFER_GEOMETRY = 0,
+    MPV_OHOS_NW_GET_BUFFER_GEOMETRY = 1,
+    MPV_OHOS_NW_SET_FORMAT          = 3,
+};
+#define MPV_OHOS_GET_GEOMETRY_OP   MPV_OHOS_NW_GET_BUFFER_GEOMETRY
+#define MPV_OHOS_SET_GEOMETRY_OP   MPV_OHOS_NW_SET_BUFFER_GEOMETRY
+#define MPV_OHOS_SET_FORMAT_OP     MPV_OHOS_NW_SET_FORMAT
+#else
+#define MPV_OHOS_GET_GEOMETRY_OP   GET_BUFFER_GEOMETRY
+#define MPV_OHOS_SET_GEOMETRY_OP   SET_BUFFER_GEOMETRY
+#define MPV_OHOS_SET_FORMAT_OP     SET_FORMAT
+#endif
+
+#include "common/common.h"
+#include "context.h"
+#include "egl_helpers.h"
+#include "video/out/ohos_common.h"
+
+struct priv {
+    struct GL gl;
+    EGLDisplay egl_display;
+    EGLContext egl_context;
+    EGLSurface egl_surface;
+    OHNativeWindow *native_window;
+};
+
+static void ohos_swap_buffers(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    eglSwapBuffers(p->egl_display, p->egl_surface);
+}
+
+static void ohos_uninit(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    ra_gl_ctx_uninit(ctx);
+
+    if (p->egl_surface) {
+        eglMakeCurrent(p->egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                       EGL_NO_CONTEXT);
+        eglDestroySurface(p->egl_display, p->egl_surface);
+    }
+    if (p->egl_context)
+        eglDestroyContext(p->egl_display, p->egl_context);
+
+    /* OHNativeWindow is owned by XComponent; do not destroy. */
+    p->native_window = NULL;
+}
+
+static bool ohos_query_native_geometry(OHNativeWindow *nw, int *out_w, int *out_h)
+{
+    int32_t h = 0, w = 0;
+    /*
+     * NativeWindowOperation::GET_BUFFER_GEOMETRY:
+     * variadic: int32_t *height, int32_t *width (per OH docs).
+     */
+    int32_t err = OH_NativeWindow_NativeWindowHandleOpt(nw, MPV_OHOS_GET_GEOMETRY_OP,
+                                                        &h, &w);
+    if (err != 0 || w <= 0 || h <= 0)
+        return false;
+    *out_w = w;
+    *out_h = h;
+    return true;
+}
+
+/* True drawable size for the default framebuffer (matches Android ANativeWindow_*). */
+static bool ohos_query_egl_drawable_size(struct priv *p, int *out_w, int *out_h)
+{
+    EGLint w = 0, h = 0;
+    if (!eglQuerySurface(p->egl_display, p->egl_surface, EGL_WIDTH, &w) ||
+        !eglQuerySurface(p->egl_display, p->egl_surface, EGL_HEIGHT, &h))
+        return false;
+    if (w <= 0 || h <= 0)
+        return false;
+    *out_w = w;
+    *out_h = h;
+    return true;
+}
+
+static void ohos_resize_swapchain(struct ra_ctx *ctx, int w, int h)
+{
+    ctx->vo->dwidth = w;
+    ctx->vo->dheight = h;
+    ra_gl_ctx_resize(ctx->swapchain, w, h, 0);
+    MP_DBG(ctx, "ohos: swapchain / VO drawable size %dx%d\n", w, h);
+}
+
+static bool ohos_reconfig(struct ra_ctx *ctx);
+
+/*
+ * Align NativeWindow format (and size when known) to the chosen EGLConfig.
+ * Otherwise OHOS EGL reports EGL_BAD_MATCH / "pixel format" and
+ * eglCreateWindowSurface fails (same role as Android setBuffersGeometry).
+ */
+static void ohos_prepare_native_window(struct ra_ctx *ctx, struct priv *p,
+                                       EGLConfig config)
+{
+    OHNativeWindow *nw = p->native_window;
+
+    int gw = 0, gh = 0;
+    if (ohos_query_native_geometry(nw, &gw, &gh)) {
+        int32_t r = OH_NativeWindow_NativeWindowHandleOpt(
+            nw, MPV_OHOS_SET_GEOMETRY_OP, (int32_t)gw, (int32_t)gh);
+        MP_VERBOSE(ctx, "ohos: SET_BUFFER_GEOMETRY %dx%d -> %d\n", gw, gh, (int)r);
+    }
+
+    EGLint nvid = 0;
+    if (eglGetConfigAttrib(p->egl_display, config, EGL_NATIVE_VISUAL_ID, &nvid) &&
+        nvid != 0) {
+        int32_t r = OH_NativeWindow_NativeWindowHandleOpt(
+            nw, MPV_OHOS_SET_FORMAT_OP, (int32_t)nvid);
+        MP_VERBOSE(ctx, "ohos: SET_FORMAT EGL_NATIVE_VISUAL_ID=%d -> %d\n",
+                   (int)nvid, (int)r);
+    }
+}
+
+static bool ohos_init(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv = talloc_zero(ctx, struct priv);
+
+    if (ctx->vo->opts->WinID == 0 || ctx->vo->opts->WinID == -1) {
+        MP_FATAL(ctx, "ohos EGL requires --wid with a valid OHNativeWindow pointer.\n");
+        goto fail;
+    }
+    p->native_window = (OHNativeWindow *)(intptr_t)ctx->vo->opts->WinID;
+
+    p->egl_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (p->egl_display == EGL_NO_DISPLAY || !eglInitialize(p->egl_display, NULL, NULL)) {
+        MP_FATAL(ctx, "EGL failed to initialize.\n");
+        goto fail;
+    }
+
+    EGLConfig config;
+    if (!mpegl_create_context(ctx, p->egl_display, &p->egl_context, &config))
+        goto fail;
+
+    ohos_prepare_native_window(ctx, p, config);
+
+    p->egl_surface = eglCreateWindowSurface(p->egl_display, config,
+        (EGLNativeWindowType)p->native_window, NULL);
+    if (p->egl_surface == EGL_NO_SURFACE) {
+        MP_FATAL(ctx, "Could not create EGL window surface.\n");
+        goto fail;
+    }
+
+    if (!eglMakeCurrent(p->egl_display, p->egl_surface, p->egl_surface,
+                        p->egl_context)) {
+        MP_FATAL(ctx, "Failed to make EGL context current.\n");
+        goto fail;
+    }
+
+    mpegl_load_functions(&p->gl, ctx->log);
+
+    struct ra_ctx_params params = { .swap_buffers = ohos_swap_buffers };
+    if (!ra_gl_ctx_init(ctx, &p->gl, params))
+        goto fail;
+
+    /*
+     * wrapped_fb must match the EGL surface size (not the video picture size).
+     * Run reconfig once here so vo_gpu's first draw_frame isn't stuck with a NULL fb.
+     */
+    if (!ohos_reconfig(ctx)) {
+        int iw = 0, ih = 0;
+        if (!ohos_query_egl_drawable_size(p, &iw, &ih))
+            ohos_query_native_geometry(p->native_window, &iw, &ih);
+        if (iw <= 0 || ih <= 0) {
+            iw = 1280;
+            ih = 720;
+            MP_WARN(ctx, "ohos: could not query drawable size; using fallback %dx%d\n", iw, ih);
+        }
+        ohos_resize_swapchain(ctx, iw, ih);
+    }
+
+    return true;
+fail:
+    ohos_uninit(ctx);
+    return false;
+}
+
+static bool ohos_reconfig(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    int w = 0, h = 0;
+    int ow = ctx->vo->opts->ohos_surface_size.w;
+    int oh = ctx->vo->opts->ohos_surface_size.h;
+
+    /*
+     * Rotation: embedding sets ohos-surface-size (physical px from
+     * OnSurfaceChanged). Update NativeWindow buffer geometry first so EGL
+     * drawable catches up, then read back the real EGL size for swapchain.
+     */
+    if (ow > 0 && oh > 0) {
+        void *window = NULL;
+        if (vo_ohos_native_window(ctx->vo, &window)) {
+            OHNativeWindow *nw = window;
+            int32_t r = OH_NativeWindow_NativeWindowHandleOpt(
+                nw, MPV_OHOS_SET_GEOMETRY_OP, (int32_t)ow, (int32_t)oh);
+            MP_VERBOSE(ctx, "ohos: reconfig SET_BUFFER_GEOMETRY %dx%d -> %d\n",
+                       ow, oh, (int)r);
+        }
+    }
+
+    if (ohos_query_egl_drawable_size(p, &w, &h)) {
+        MP_DBG(ctx, "ohos: reconfig EGL drawable %dx%d (override %dx%d)\n",
+               w, h, ow, oh);
+    } else if (ow > 0 && oh > 0) {
+        w = ow;
+        h = oh;
+        MP_DBG(ctx, "ohos: reconfig fallback override %dx%d\n", w, h);
+    } else if (ohos_query_native_geometry(p->native_window, &w, &h)) {
+        MP_DBG(ctx, "ohos: reconfig native geometry %dx%d\n", w, h);
+    } else {
+        return false;
+    }
+
+    ohos_resize_swapchain(ctx, w, h);
+    return true;
+}
+
+static int ohos_control(struct ra_ctx *ctx, int *events, int request, void *arg)
+{
+    return VO_NOTIMPL;
+}
+
+const struct ra_ctx_fns ra_ctx_ohos = {
+    .type           = "opengl",
+    .name           = "ohos",
+    .description    = "OpenHarmony EGL (OHNativeWindow)",
+    .reconfig       = ohos_reconfig,
+    .control        = ohos_control,
+    .init           = ohos_init,
+    .uninit         = ohos_uninit,
+};
