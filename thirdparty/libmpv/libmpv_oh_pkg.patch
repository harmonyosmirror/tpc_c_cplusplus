diff --git a/audio/out/ao_ohaudio.c b/audio/out/ao_ohaudio.c
new file mode 100755
index 0000000..55a3047
--- /dev/null
+++ b/audio/out/ao_ohaudio.c
@@ -0,0 +1,333 @@
+/*
+ * OpenHarmony audio output driver.
+ *
+ * Simplified implementation with multi-format support.
+ */
+
+#include <inttypes.h>
+#include <limits.h>
+#include <string.h>
+#include <time.h>
+
+#include "ao.h"
+#include "internal.h"
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "audio/format.h"
+#include "osdep/timer.h"
+
+#include <ohaudio/native_audiorenderer.h>
+#include <ohaudio/native_audiostream_base.h>
+#include <ohaudio/native_audiostreambuilder.h>
+
+#include "options/m_option.h"
+
+struct priv {
+    OH_AudioRenderer *renderer;
+    OH_AudioStreamBuilder *builder;
+
+    int32_t buffer_capacity;
+    int latency_mode;
+
+    int64_t presented;
+    int64_t discarded;
+    int64_t last_timestamp_query_ns;
+};
+
+#define OH_TIMESTAMP_QUERY_INTERVAL_NS MP_TIME_MS_TO_NS(200)
+
+static int get_ohaudio_bytes_per_sample(int format)
+{
+    switch (format) {
+    case AF_FORMAT_U8:
+        return 1;
+    case AF_FORMAT_S16:
+    case AF_FORMAT_S16P:
+        return 2;
+    case AF_FORMAT_S32:
+    case AF_FORMAT_S32P:
+    case AF_FORMAT_FLOAT:
+    case AF_FORMAT_FLOATP:
+        return 4;
+    default:
+        return 4;
+    }
+}
+
+static OH_AudioData_Callback_Result audio_renderer_write_callback(
+    OH_AudioRenderer *renderer, void *userData, void *audioData, int32_t audioDataSize)
+{
+    struct ao *ao = userData;
+    if (!ao || !ao->priv || !audioData || audioDataSize <= 0) {
+        return AUDIO_DATA_CALLBACK_RESULT_INVALID;
+    }
+
+    struct priv *p = ao->priv;
+
+    const int bytes_per_frame = ao->channels.num * get_ohaudio_bytes_per_sample(ao->format);
+    if (bytes_per_frame <= 0 || (audioDataSize % bytes_per_frame)) {
+        memset(audioData, 0, (size_t)audioDataSize);
+        return AUDIO_DATA_CALLBACK_RESULT_VALID;
+    }
+
+    int frames = audioDataSize / bytes_per_frame;
+
+    int64_t written = 0;
+    if (OH_AudioRenderer_GetFramesWritten(renderer, &written) != AUDIOSTREAM_SUCCESS)
+        written = p->presented + p->discarded;
+
+    int64_t presented = p->presented;
+    int64_t now = mp_time_ns();
+    if (now - p->last_timestamp_query_ns >= OH_TIMESTAMP_QUERY_INTERVAL_NS) {
+        int64_t frame_position = presented;
+        int64_t present_time = 0;
+        if (OH_AudioRenderer_GetTimestamp(renderer, CLOCK_MONOTONIC, &frame_position,
+                                          &present_time) == AUDIOSTREAM_SUCCESS) {
+            p->presented = frame_position;
+            p->last_timestamp_query_ns = now;
+        }
+        presented = p->presented;
+    }
+
+    int64_t end_time = mp_time_ns();
+    if (ao->samplerate > 0) {
+        end_time += MP_TIME_S_TO_NS(frames) / ao->samplerate;
+        end_time += MP_TIME_S_TO_NS(written - (presented + p->discarded)) / ao->samplerate;
+    }
+
+    void *planes[1] = { audioData };
+    ao_read_data(ao, planes, frames, end_time, NULL, true, true);
+
+    return AUDIO_DATA_CALLBACK_RESULT_VALID;
+}
+
+static void ohaudio_try_set_callback_frame_size(struct ao *ao, OH_AudioStreamBuilder *builder)
+{
+    struct priv *p = ao->priv;
+    if (p->buffer_capacity <= 0)
+        return;
+
+    int32_t period = p->buffer_capacity / 4;
+    int32_t period_max = MPMAX(ao->samplerate / 20, 1);
+    period = MPCLAMP(period, 1, period_max);
+
+    OH_AudioStream_Result ret =
+        OH_AudioStreamBuilder_SetFrameSizeInCallback(builder, period);
+    if (ret != AUDIOSTREAM_SUCCESS) {
+        MP_WARN(ao, "SetFrameSizeInCallback(%" PRId32 ") failed (%d); using default\n",
+                period, (int)ret);
+    }
+}
+
+static int init(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    p->renderer = NULL;
+    p->builder = NULL;
+    p->presented = 0;
+    p->discarded = 0;
+    p->last_timestamp_query_ns = 0;
+
+    if (af_fmt_is_spdif(ao->format)) {
+        MP_ERR(ao, "SPDIF passthrough is not supported on OHAudio.\n");
+        return -1;
+    }
+
+    OH_AudioStream_SampleFormat oh_format;
+
+    if (af_fmt_is_float(ao->format)) {
+        ao->format = AF_FORMAT_FLOAT;
+        oh_format = AUDIOSTREAM_SAMPLE_F32LE;
+        MP_DBG(ao, "ohaudio: using F32LE format\n");
+    } else if (af_fmt_is_int(ao->format)) {
+        if (af_fmt_to_bytes(ao->format) > 2) {
+            ao->format = AF_FORMAT_S32;
+            oh_format = AUDIOSTREAM_SAMPLE_S32LE;
+            MP_DBG(ao, "ohaudio: using S32LE format\n");
+        } else {
+            ao->format = AF_FORMAT_S16;
+            oh_format = AUDIOSTREAM_SAMPLE_S16LE;
+            MP_DBG(ao, "ohaudio: using S16LE format\n");
+        }
+    } else {
+        ao->format = AF_FORMAT_S32;
+        oh_format = AUDIOSTREAM_SAMPLE_S32LE;
+        MP_DBG(ao, "ohaudio: fallback to S32LE format\n");
+    }
+
+    OH_AudioStream_Result ret;
+
+    ret = OH_AudioStreamBuilder_Create(&p->builder, AUDIOSTREAM_TYPE_RENDERER);
+    if (ret != AUDIOSTREAM_SUCCESS) {
+        MP_ERR(ao, "Failed to create audio stream builder\n");
+        return -1;
+    }
+
+    ret = OH_AudioStreamBuilder_SetSamplingRate(p->builder, ao->samplerate);
+    if (ret != AUDIOSTREAM_SUCCESS) {
+        MP_ERR(ao, "OH_AudioStreamBuilder_SetSamplingRate(%d) failed (%d)\n", ao->samplerate, (int)ret);
+        goto fail;
+    }
+
+    ret = OH_AudioStreamBuilder_SetChannelCount(p->builder, ao->channels.num);
+    if (ret != AUDIOSTREAM_SUCCESS) {
+        MP_ERR(ao, "OH_AudioStreamBuilder_SetChannelCount(%d) failed (%d)\n", ao->channels.num, (int)ret);
+        goto fail;
+    }
+
+    ret = OH_AudioStreamBuilder_SetSampleFormat(p->builder, oh_format);
+    if (ret != AUDIOSTREAM_SUCCESS) {
+        MP_WARN(ao, "Failed to set sample format %d, trying S32LE fallback\n", (int)oh_format);
+        oh_format = AUDIOSTREAM_SAMPLE_S32LE;
+        ao->format = AF_FORMAT_S32;
+        ret = OH_AudioStreamBuilder_SetSampleFormat(p->builder, oh_format);
+        if (ret != AUDIOSTREAM_SUCCESS) {
+            MP_ERR(ao, "OH_AudioStreamBuilder_SetSampleFormat(S32LE) failed (%d)\n", (int)ret);
+            goto fail;
+        }
+    }
+
+    ret = OH_AudioStreamBuilder_SetEncodingType(p->builder, AUDIOSTREAM_ENCODING_TYPE_RAW);
+    if (ret != AUDIOSTREAM_SUCCESS) {
+        MP_ERR(ao, "OH_AudioStreamBuilder_SetEncodingType() failed (%d)\n", (int)ret);
+        goto fail;
+    }
+
+    ret = OH_AudioStreamBuilder_SetLatencyMode(p->builder,
+                                               (OH_AudioStream_LatencyMode)p->latency_mode);
+    if (ret != AUDIOSTREAM_SUCCESS) {
+        MP_ERR(ao, "OH_AudioStreamBuilder_SetLatencyMode(%d) failed (%d)\n", p->latency_mode, (int)ret);
+        goto fail;
+    }
+
+    ret = OH_AudioStreamBuilder_SetRendererInfo(p->builder, AUDIOSTREAM_USAGE_MUSIC);
+    if (ret != AUDIOSTREAM_SUCCESS) {
+        MP_ERR(ao, "OH_AudioStreamBuilder_SetRendererInfo() failed (%d)\n", (int)ret);
+        goto fail;
+    }
+
+    ohaudio_try_set_callback_frame_size(ao, p->builder);
+
+    ret = OH_AudioStreamBuilder_SetRendererWriteDataCallback(p->builder,
+                                                             audio_renderer_write_callback, ao);
+    if (ret != AUDIOSTREAM_SUCCESS) {
+        MP_ERR(ao, "Failed to set OHAudio write callback\n");
+        goto fail;
+    }
+
+    ret = OH_AudioStreamBuilder_GenerateRenderer(p->builder, &p->renderer);
+    if (ret != AUDIOSTREAM_SUCCESS || !p->renderer) {
+        MP_ERR(ao, "Failed to generate OHAudio renderer\n");
+        goto fail;
+    }
+
+    int32_t cb_frames = 0;
+    OH_AudioRenderer_GetFrameSizeInCallback(p->renderer, &cb_frames);
+
+    if (p->buffer_capacity > 0) {
+        ao->device_buffer = p->buffer_capacity;
+    } else if (cb_frames > 0) {
+        ao->device_buffer = MPMAX(cb_frames * 4, cb_frames);
+    } else {
+        ao->device_buffer = MPMAX(ao->samplerate / 10, 1);
+    }
+
+    MP_VERBOSE(ao, "ohaudio: format=%s, device_buffer=%d samples (callback frames=%" PRId32 ")\n",
+               af_fmt_to_str(ao->format), ao->device_buffer, cb_frames);
+
+    OH_AudioStreamBuilder_Destroy(p->builder);
+    p->builder = NULL;
+
+    return 0;
+
+fail:
+    OH_AudioStreamBuilder_Destroy(p->builder);
+    p->builder = NULL;
+    return -1;
+}
+
+static void uninit(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    if (p->renderer) {
+        OH_AudioRenderer_Stop(p->renderer);
+        OH_AudioRenderer_Release(p->renderer);
+        p->renderer = NULL;
+    }
+
+    if (p->builder) {
+        OH_AudioStreamBuilder_Destroy(p->builder);
+        p->builder = NULL;
+    }
+}
+
+static void reset(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    if (p->renderer)
+        OH_AudioRenderer_Stop(p->renderer);
+}
+
+static bool set_pause(struct ao *ao, bool paused)
+{
+    struct priv *p = ao->priv;
+    if (!p->renderer)
+        return true;
+
+    OH_AudioStream_Result ret = paused ? OH_AudioRenderer_Pause(p->renderer) : OH_AudioRenderer_Start(p->renderer);
+    if (ret != AUDIOSTREAM_SUCCESS) {
+        MP_ERR(ao, "OH_AudioRenderer_%s failed (%d)\n", paused ? "Pause" : "Start", (int)ret);
+        ao_request_reload(ao);
+        return false;
+    }
+
+    return true;
+}
+
+static void start(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    if (p->renderer) {
+        int64_t written = 0;
+        if (OH_AudioRenderer_GetFramesWritten(p->renderer, &written) == AUDIOSTREAM_SUCCESS)
+            p->discarded = written - p->presented;
+        p->last_timestamp_query_ns = 0;
+        OH_AudioRenderer_Start(p->renderer);
+    }
+}
+
+#define OPT_BASE_STRUCT struct priv
+
+static const struct m_option ohaudio_opts[] = {
+    {"buffer-capacity",
+        OPT_CHOICE(buffer_capacity, {"auto", 0}),
+        M_RANGE(1, INT32_MAX)},
+    {"performance-mode",
+        OPT_CHOICE(latency_mode,
+            {"none", AUDIOSTREAM_LATENCY_MODE_NORMAL},
+            {"low-latency", AUDIOSTREAM_LATENCY_MODE_FAST},
+            {"power-saving", AUDIOSTREAM_LATENCY_MODE_NORMAL})},
+    {0},
+};
+
+const struct ao_driver audio_out_ohaudio = {
+    .name = "ohaudio",
+    .description = "OpenHarmony audio output",
+    .priv_size = sizeof(struct priv),
+    .priv_defaults = &(const struct priv) {
+        .buffer_capacity = 0,
+        .latency_mode = AUDIOSTREAM_LATENCY_MODE_NORMAL,
+    },
+    .options = ohaudio_opts,
+    .options_prefix = "ohaudio",
+    .init = init,
+    .uninit = uninit,
+    .reset = reset,
+    .set_pause = set_pause,
+    .start = start,
+};
