diff --git a/video/out/hwdec/hwdec_oh.h b/video/out/hwdec/hwdec_oh.h
new file mode 100755
index 0000000..b507480
--- /dev/null
+++ b/video/out/hwdec/hwdec_oh.h
@@ -0,0 +1,56 @@
+/*
+ * OpenHarmony ohcodec helpers (shared by hwdec_ohnativeimage and player).
+ *
+ * Opaque layout of AVFrame.buf[0] from libavcodec/ohdec.c.
+ */
+
+#ifndef MP_HWDEC_OH_H
+#define MP_HWDEC_OH_H
+
+#include "config.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <libavutil/buffer.h>
+#include <multimedia/player_framework/native_avbuffer.h>
+#include <multimedia/player_framework/native_avcodec_base.h>
+#include <multimedia/player_framework/native_avcodec_videodecoder.h>
+
+#include "video/img_format.h"
+#include "video/mp_image.h"
+
+typedef struct OHCodecBuffer {
+    uint32_t index;
+    OH_AVBuffer *buffer;
+    AVBufferRef *dec_ref;
+} OHCodecBuffer;
+
+static inline OHCodecBuffer *mp_image_ohcodec_buffer(struct mp_image *img)
+{
+    if (!img || img->imgfmt != IMGFMT_OHCODEC || !img->bufs[0])
+        return NULL;
+    return av_buffer_get_opaque(img->bufs[0]);
+}
+
+static inline bool mp_image_ohcodec_usable(struct mp_image *img)
+{
+    OHCodecBuffer *buf = mp_image_ohcodec_buffer(img);
+    return buf && buf->buffer && buf->dec_ref;
+}
+
+/* Return an ohcodec output buffer to the decoder without rendering. */
+static inline void mp_image_discard_ohcodec(struct mp_image *img)
+{
+    OHCodecBuffer *buf = mp_image_ohcodec_buffer(img);
+    if (!buf || !buf->buffer || !buf->dec_ref)
+        return;
+
+    OH_AVCodec *dec = (OH_AVCodec *)buf->dec_ref->data;
+    if (dec) {
+        OH_VideoDecoder_FreeOutputBuffer(dec, buf->index);
+        buf->buffer = NULL;
+    }
+}
+
+#endif
\ No newline at end of file
diff --git a/video/out/hwdec/hwdec_ohnativeimage.c b/video/out/hwdec/hwdec_ohnativeimage.c
new file mode 100755
index 0000000..7b66254
--- /dev/null
+++ b/video/out/hwdec/hwdec_ohnativeimage.c
@@ -0,0 +1,322 @@
+/*
+ * OpenHarmony NativeImage hwdec interop (OHOS counterpart of hwdec_aimagereader).
+ *
+ * Lifecycle mirrors hwdec_aimagereader.c:
+ *   init/uninit: off-screen surface + hw device for the decoder
+ *   mapper_init/uninit: GL external-OES texture wrap + frame listener
+ *   mapper_map: RenderOutputBuffer, wait, AttachContext, UpdateSurfaceImage
+ *   mapper_unmap: DetachContext + clear frame state (AImage_delete / EGLImage destroy)
+ *
+ * OH API note: OH_NativeImage_Create() requires a GL texture at creation time,
+ * so gl_texture lives in priv_owner (Android creates AImageReader without a
+ * texture and allocates the mapper texture separately).
+ */
+
+#include <assert.h>
+#include <EGL/egl.h>
+#include <libavutil/buffer.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_oh.h>
+#include <multimedia/player_framework/native_avbuffer.h>
+#include <multimedia/player_framework/native_avcodec_base.h>
+#include <multimedia/player_framework/native_avcodec_videodecoder.h>
+#include <native_image/native_image.h>
+
+#include "config.h"
+#include "common/common.h"
+#include "common/msg.h"
+#include "osdep/threads.h"
+#include "osdep/timer.h"
+#include "video/img_format.h"
+#include "video/out/gpu/hwdec.h"
+#include "video/out/hwdec/hwdec_oh.h"
+#include "video/out/opengl/gl_headers.h"
+#include "video/out/opengl/ra_gl.h"
+
+struct priv_owner {
+    struct mp_hwdec_ctx hwctx;
+    OH_NativeImage *native_image;
+    OHNativeWindow *native_window;
+    GLuint gl_texture;
+    mp_mutex lock;
+    mp_cond cond;
+    bool frame_available;
+};
+
+struct priv {
+    struct mp_log *log;
+};
+
+static AVBufferRef *create_ohcodec_device_ref(OHNativeWindow *window)
+{
+    AVBufferRef *device_ref = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_OHCODEC);
+    if (!device_ref)
+        return NULL;
+
+    AVHWDeviceContext *ctx = (void *)device_ref->data;
+    AVOHCodecDeviceContext *hwctx = ctx->hwctx;
+    hwctx->native_window = window;
+
+    if (av_hwdevice_ctx_init(device_ref) < 0)
+        av_buffer_unref(&device_ref);
+
+    return device_ref;
+}
+
+static void destroy_native_image(struct priv_owner *o)
+{
+    if (!o->native_image)
+        return;
+
+    OH_NativeImage_UnsetOnFrameAvailableListener(o->native_image);
+    OH_NativeImage_DetachContext(o->native_image);
+    OH_NativeImage_Destroy(&o->native_image);
+    o->native_window = NULL;
+
+    mp_mutex_destroy(&o->lock);
+    mp_cond_destroy(&o->cond);
+}
+
+static void frame_callback(void *context)
+{
+    struct priv_owner *o = context;
+
+    mp_mutex_lock(&o->lock);
+    o->frame_available = true;
+    mp_cond_signal(&o->cond);
+    mp_mutex_unlock(&o->lock);
+}
+
+static int init(struct ra_hwdec *hw)
+{
+    struct priv_owner *p = hw->priv;
+    GL *gl;
+
+    if (!ra_is_gl(hw->ra_ctx->ra))
+        return -1;
+    if (!eglGetCurrentContext())
+        return -1;
+
+    gl = ra_gl_get(hw->ra_ctx->ra);
+    static const char *es2_exts[] = {"GL_OES_EGL_image_external", 0};
+    static const char *es3_exts[] = {"GL_OES_EGL_image_external_essl3", 0};
+    if (gl_check_extension(gl->extensions, es3_exts[0]))
+        hw->glsl_extensions = es3_exts;
+    else if (gl_check_extension(gl->extensions, es2_exts[0]))
+        hw->glsl_extensions = es2_exts;
+    else
+        return -1;
+
+    gl->GenTextures(1, &p->gl_texture);
+    gl->BindTexture(GL_TEXTURE_EXTERNAL_OES, p->gl_texture);
+    gl->TexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    gl->TexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    gl->TexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    gl->TexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    gl->BindTexture(GL_TEXTURE_EXTERNAL_OES, 0);
+
+    p->native_image = OH_NativeImage_Create(p->gl_texture, GL_TEXTURE_EXTERNAL_OES);
+    if (!p->native_image) {
+        MP_ERR(hw, "OH_NativeImage_Create failed\n");
+        return -1;
+    }
+
+    OH_NativeImage_SetDropBufferMode(p->native_image, true);
+
+    mp_mutex_init(&p->lock);
+    mp_cond_init(&p->cond);
+    p->frame_available = false;
+
+    OH_OnFrameAvailableListener listener = {
+        .context = p,
+        .onFrameAvailable = frame_callback,
+    };
+    if (OH_NativeImage_SetOnFrameAvailableListener(p->native_image, listener) != 0) {
+        MP_ERR(hw, "OH_NativeImage_SetOnFrameAvailableListener failed\n");
+        return -1;
+    }
+
+    p->native_window = OH_NativeImage_AcquireNativeWindow(p->native_image);
+    if (!p->native_window) {
+        MP_ERR(hw, "OH_NativeImage_AcquireNativeWindow failed\n");
+        return -1;
+    }
+
+    p->hwctx = (struct mp_hwdec_ctx) {
+        .driver_name = hw->driver->name,
+        .av_device_ref = create_ohcodec_device_ref(p->native_window),
+        .hw_imgfmt = IMGFMT_OHCODEC,
+    };
+
+    if (!p->hwctx.av_device_ref) {
+        MP_VERBOSE(hw, "Failed to create ohcodec hwdevice_ctx\n");
+        return -1;
+    }
+
+    hwdec_devices_add(hw->devs, &p->hwctx);
+
+    return 0;
+}
+
+static void uninit(struct ra_hwdec *hw)
+{
+    struct priv_owner *p = hw->priv;
+
+    hwdec_devices_remove(hw->devs, &p->hwctx);
+    av_buffer_unref(&p->hwctx.av_device_ref);
+
+    destroy_native_image(p);
+
+    if (p->gl_texture) {
+        GL *gl = ra_gl_get(hw->ra_ctx->ra);
+        if (gl)
+            gl->DeleteTextures(1, &p->gl_texture);
+        p->gl_texture = 0;
+    }
+}
+
+static int mapper_init(struct ra_hwdec_mapper *mapper)
+{
+    struct priv *p = mapper->priv;
+    struct priv_owner *o = mapper->owner->priv;
+
+    p->log = mapper->log;
+
+    mapper->dst_params = mapper->src_params;
+    mapper->dst_params.imgfmt = IMGFMT_RGB0;
+    mapper->dst_params.hw_subfmt = 0;
+
+    struct ra_tex_params params = {
+        .dimensions = 2,
+        .w = mapper->src_params.w,
+        .h = mapper->src_params.h,
+        .d = 1,
+        .format = ra_find_unorm_format(mapper->ra, 1, 4),
+        .render_src = true,
+        .src_linear = true,
+        .external_oes = true,
+    };
+
+    if (params.format->ctype != RA_CTYPE_UNORM)
+        return -1;
+
+    mapper->tex[0] = ra_create_wrapped_tex(mapper->ra, &params, o->gl_texture);
+    if (!mapper->tex[0])
+        return -1;
+
+    return 0;
+}
+
+static void mapper_uninit(struct ra_hwdec_mapper *mapper)
+{
+    struct priv_owner *o = mapper->owner->priv;
+    OH_NativeImage_DetachContext(o->native_image);
+    ra_tex_free(mapper->ra, &mapper->tex[0]);
+}
+
+static void mapper_unmap(struct ra_hwdec_mapper *mapper)
+{
+    struct priv_owner *o = mapper->owner->priv;
+    OH_NativeImage_DetachContext(o->native_image);
+}
+
+static bool oh_bind_surface_image(struct ra_hwdec_mapper *mapper,
+                                  struct priv_owner *o, GL *gl)
+{
+    if (OH_NativeImage_AttachContext(o->native_image, o->gl_texture) != 0) {
+        OH_NativeImage_DetachContext(o->native_image);
+        if (OH_NativeImage_AttachContext(o->native_image, o->gl_texture) != 0) {
+            MP_VERBOSE(mapper, "Skipping ohcodec map: AttachContext failed\n");
+            return false;
+        }
+    }
+
+    if (OH_NativeImage_UpdateSurfaceImage(o->native_image) != 0) {
+        OH_NativeImage_DetachContext(o->native_image);
+        MP_VERBOSE(mapper, "Skipping ohcodec map: UpdateSurfaceImage failed\n");
+        return false;
+    }
+
+    if (gl) {
+        gl->BindTexture(GL_TEXTURE_EXTERNAL_OES, o->gl_texture);
+        gl->BindTexture(GL_TEXTURE_EXTERNAL_OES, 0);
+    }
+    return true;
+}
+
+static int mapper_map(struct ra_hwdec_mapper *mapper)
+{
+    struct priv_owner *o = mapper->owner->priv;
+    GL *gl = ra_gl_get(mapper->ra);
+
+    if (mapper->src->imgfmt != IMGFMT_OHCODEC) {
+        MP_VERBOSE(mapper, "Skipping ohcodec map: unexpected imgfmt %s\n",
+                   mp_imgfmt_to_name(mapper->src->imgfmt));
+        return 0;
+    }
+
+    OHCodecBuffer *buffer = mp_image_ohcodec_buffer(mapper->src);
+    if (!buffer || !buffer->dec_ref) {
+        MP_VERBOSE(mapper, "Skipping stale ohcodec map: no buffer\n");
+        return 0;
+    }
+    if (!mp_image_ohcodec_usable(mapper->src)) {
+        MP_VERBOSE(mapper, "Skipping stale ohcodec map: buffer not usable\n");
+        return 0;
+    }
+
+    OH_AVCodecBufferAttr attr;
+    if (OH_AVBuffer_GetBufferAttr(buffer->buffer, &attr) != AV_ERR_OK) {
+        MP_VERBOSE(mapper, "Skipping stale ohcodec map: GetBufferAttr failed\n");
+        return 0;
+    }
+    if (attr.flags & AVCODEC_BUFFER_FLAGS_DISCARD) {
+        MP_VERBOSE(mapper, "Skipping stale ohcodec map: buffer discarded\n");
+        return 0;
+    }
+
+    OH_AVCodec *dec = (OH_AVCodec *)buffer->dec_ref->data;
+    if (!dec || OH_VideoDecoder_RenderOutputBuffer(dec, buffer->index) != AV_ERR_OK) {
+        MP_VERBOSE(mapper, "Skipping stale ohcodec map: RenderOutputBuffer failed\n");
+        return 0;
+    }
+
+    buffer->buffer = NULL;
+
+    bool frame_available = false;
+    mp_mutex_lock(&o->lock);
+    if (!o->frame_available) {
+        mp_cond_timedwait(&o->cond, &o->lock, MP_TIME_MS_TO_NS(100));
+        if (!o->frame_available)
+            MP_WARN(mapper, "Waiting for frame timed out!\n");
+    }
+    frame_available = o->frame_available;
+    o->frame_available = false;
+    mp_mutex_unlock(&o->lock);
+
+    if (!frame_available) {
+        MP_VERBOSE(mapper, "Skipping stale ohcodec map: no frame available\n");
+        return 0;
+    }
+
+    if (!oh_bind_surface_image(mapper, o, gl))
+        return 0;
+
+    return 0;
+}
+
+const struct ra_hwdec_driver ra_hwdec_ohnativeimage = {
+    .name = "ohnativeimage",
+    .priv_size = sizeof(struct priv_owner),
+    .imgfmts = {IMGFMT_OHCODEC, 0},
+    .device_type = AV_HWDEVICE_TYPE_OHCODEC,
+    .init = init,
+    .uninit = uninit,
+    .mapper = &(const struct ra_hwdec_mapper_driver){
+        .priv_size = sizeof(struct priv),
+        .init = mapper_init,
+        .uninit = mapper_uninit,
+        .map = mapper_map,
+        .unmap = mapper_unmap,
+    },
+};
diff --git a/video/out/ohos_common.c b/video/out/ohos_common.c
new file mode 100755
index 0000000..fe8bc19
--- /dev/null
+++ b/video/out/ohos_common.c
@@ -0,0 +1,52 @@
+/*
+ * OpenHarmony: OHNativeWindow helpers for vo=gpu (--wid).
+ */
+
+#include <native_window/external_window.h>
+
+#include "common/msg.h"
+#include "ohos_common.h"
+#include "vo.h"
+
+#ifndef GET_BUFFER_GEOMETRY
+enum {
+    MPV_OHOS_NW_GET_BUFFER_GEOMETRY = 1,
+};
+#define MPV_OHOS_GET_GEOMETRY_OP MPV_OHOS_NW_GET_BUFFER_GEOMETRY
+#else
+#define MPV_OHOS_GET_GEOMETRY_OP GET_BUFFER_GEOMETRY
+#endif
+
+bool vo_ohos_native_window(struct vo *vo, void **out_window)
+{
+    if (!vo || vo->opts->WinID == 0 || vo->opts->WinID == -1)
+        return false;
+    *out_window = (void *)(intptr_t)vo->opts->WinID;
+    return true;
+}
+
+bool vo_ohos_surface_size(struct vo *vo, int *out_w, int *out_h)
+{
+    int w = vo->opts->ohos_surface_size.w;
+    int h = vo->opts->ohos_surface_size.h;
+
+    void *window = NULL;
+    if ((!w || !h) && vo_ohos_native_window(vo, &window)) {
+        OHNativeWindow *nw = window;
+        int32_t gh = 0, gw = 0;
+        if (OH_NativeWindow_NativeWindowHandleOpt(nw, MPV_OHOS_GET_GEOMETRY_OP,
+                                                  &gh, &gw) == 0 && gw > 0 && gh > 0) {
+            w = gw;
+            h = gh;
+        }
+    }
+
+    if (w <= 0 || h <= 0) {
+        MP_ERR(vo, "Failed to get OHOS surface height and width.\n");
+        return false;
+    }
+
+    *out_w = w;
+    *out_h = h;
+    return true;
+}
