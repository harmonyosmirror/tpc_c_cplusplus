diff --git a/video/out/vo_ohos_avcodec_embed.c b/video/out/vo_ohos_avcodec_embed.c
new file mode 100755
index 0000000..f5aa05a
--- /dev/null
+++ b/video/out/vo_ohos_avcodec_embed.c
@@ -0,0 +1,140 @@
+/*
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_oh.h>
+#include <libavutil/pixfmt.h>
+
+#include "common/common.h"
+#include "vo.h"
+#include "video/fmt-conversion.h"
+#include "video/mp_image.h"
+#include "video/hwdec.h"
+
+struct priv {
+    struct mp_image *next_image;
+    struct mp_hwdec_ctx hwctx;
+};
+
+static AVBufferRef *create_ohcodec_device_ref(struct vo *vo)
+{
+    AVBufferRef *device_ref = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_OHCODEC);
+    if (!device_ref)
+        return NULL;
+
+    AVHWDeviceContext *ctx = (void *)device_ref->data;
+    AVOHCodecDeviceContext *hwctx = ctx->hwctx;
+    mp_assert(vo->opts->WinID != 0 && vo->opts->WinID != -1);
+    hwctx->native_window = (void *)(intptr_t)(vo->opts->WinID);
+
+    if (av_hwdevice_ctx_init(device_ref) < 0) {
+        av_buffer_unref(&device_ref);
+        return NULL;
+    }
+
+    return device_ref;
+}
+
+static int preinit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (vo->opts->WinID == 0 || vo->opts->WinID == -1) {
+        MP_ERR(vo, "ohos_avcodec_embed requires --wid with a valid "
+                   "OHNativeWindow pointer.\n");
+        return -1;
+    }
+
+    vo->hwdec_devs = hwdec_devices_create();
+    p->hwctx = (struct mp_hwdec_ctx){
+        .driver_name = "ohos_avcodec_embed",
+        .av_device_ref = create_ohcodec_device_ref(vo),
+        .hw_imgfmt = pixfmt2imgfmt(AV_PIX_FMT_OHCODEC),
+    };
+
+    if (!p->hwctx.av_device_ref) {
+        MP_VERBOSE(vo, "Failed to create OHOS ohcodec hwdevice context.\n");
+        return -1;
+    }
+
+    hwdec_devices_add(vo->hwdec_devs, &p->hwctx);
+    return 0;
+}
+
+static void flip_page(struct vo *vo)
+{
+    // OpenHarmony ohcodec renders the output buffer to the surface when the
+    // AVBufferRef backing the frame is unref'd (see libavcodec/ohdec.c:
+    // oh_buffer_release). Dropping our last reference here submits the frame
+    // for display. To discard a frame instead of rendering it, the ohcodec
+    // buffer attr would need to be tagged with AVCODEC_BUFFER_FLAGS_DISCARD
+    // before unref; we don't do that since every frame that reaches flip_page
+    // is meant to be shown.
+    struct priv *p = vo->priv;
+    mp_image_unrefp(&p->next_image);
+}
+
+static bool draw_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+
+    mp_image_t *mpi = NULL;
+    if (!frame->redraw && !frame->repeat)
+        mpi = mp_image_new_ref(frame->current);
+
+    talloc_free(p->next_image);
+    p->next_image = mpi;
+    return VO_TRUE;
+}
+
+static int query_format(struct vo *vo, int format)
+{
+    return format == pixfmt2imgfmt(AV_PIX_FMT_OHCODEC);
+}
+
+static int control(struct vo *vo, uint32_t request, void *data)
+{
+    return VO_NOTIMPL;
+}
+
+static int reconfig(struct vo *vo, struct mp_image_params *params)
+{
+    return 0;
+}
+
+static void uninit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    mp_image_unrefp(&p->next_image);
+
+    hwdec_devices_remove(vo->hwdec_devs, &p->hwctx);
+    av_buffer_unref(&p->hwctx.av_device_ref);
+}
+
+const struct vo_driver vo_out_ohos_avcodec_embed = {
+    .description = "OHOS (Embedded AVCodec Surface)",
+    .name = "ohos_avcodec_embed",
+    .caps = VO_CAP_NORETAIN,
+    .preinit = preinit,
+    .query_format = query_format,
+    .control = control,
+    .draw_frame = draw_frame,
+    .flip_page = flip_page,
+    .reconfig = reconfig,
+    .uninit = uninit,
+    .priv_size = sizeof(struct priv),
+};
diff --git a/video/out/vulkan/context_ohos.c b/video/out/vulkan/context_ohos.c
new file mode 100755
index 0000000..d02090c
--- /dev/null
+++ b/video/out/vulkan/context_ohos.c
@@ -0,0 +1,161 @@
+/*
+ * OpenHarmony / OHOS: Vulkan + OHNativeWindow (--wid).
+ * Counterpart of context_android.c (VK_KHR_android_surface) and
+ * opengl/context_ohos.c (EGL).
+ */
+
+#include <vulkan/vulkan.h>
+
+#include <native_window/external_window.h>
+
+#if __has_include(<vulkan/vulkan_ohos.h>)
+#include <vulkan/vulkan_ohos.h>
+#define MPV_HAS_VULKAN_OHOS_H 1
+#endif
+
+#include "common/common.h"
+#include "context.h"
+#include "utils.h"
+#include "video/out/ohos_common.h"
+
+#ifndef GET_BUFFER_GEOMETRY
+enum {
+    MPV_OHOS_NW_SET_BUFFER_GEOMETRY = 0,
+};
+#define MPV_OHOS_SET_GEOMETRY_OP MPV_OHOS_NW_SET_BUFFER_GEOMETRY
+#else
+#define MPV_OHOS_SET_GEOMETRY_OP SET_BUFFER_GEOMETRY
+#endif
+
+#ifndef MPV_HAS_VULKAN_OHOS_H
+#ifndef VK_OHOS_SURFACE_EXTENSION_NAME
+#define VK_OHOS_SURFACE_EXTENSION_NAME "VK_OHOS_surface"
+#endif
+
+#ifndef VK_STRUCTURE_TYPE_SURFACE_CREATE_INFO_OHOS
+#define VK_STRUCTURE_TYPE_SURFACE_CREATE_INFO_OHOS \
+    ((VkStructureType)1000069000)
+#endif
+
+#ifndef VKAPI_CALL
+#define VKAPI_CALL
+#endif
+#ifndef VKAPI_PTR
+#define VKAPI_PTR *
+#endif
+
+typedef VkFlags VkSurfaceCreateFlagsOHOS;
+
+typedef struct VkSurfaceCreateInfoOHOS {
+    VkStructureType             sType;
+    const void                 *pNext;
+    VkSurfaceCreateFlagsOHOS    flags;
+    OHNativeWindow             *window;
+} VkSurfaceCreateInfoOHOS;
+
+typedef VkResult (VKAPI_PTR *PFN_vkCreateSurfaceOHOS)(VkInstance instance,
+    const VkSurfaceCreateInfoOHOS *pCreateInfo,
+    const VkAllocationCallbacks *pAllocator, VkSurfaceKHR *pSurface);
+#endif
+
+struct priv {
+    struct mpvk_ctx vk;
+    OHNativeWindow *native_window;
+};
+
+static PFN_vkCreateSurfaceOHOS get_create_surface_ohos(VkInstance inst)
+{
+    return (PFN_vkCreateSurfaceOHOS)
+        vkGetInstanceProcAddr(inst, "vkCreateSurfaceOHOS");
+}
+
+static void ohos_apply_surface_geometry(struct ra_ctx *ctx, OHNativeWindow *nw,
+                                        int w, int h)
+{
+    if (!nw || w <= 0 || h <= 0)
+        return;
+    int32_t r = OH_NativeWindow_NativeWindowHandleOpt(
+        nw, MPV_OHOS_SET_GEOMETRY_OP, (int32_t)w, (int32_t)h);
+    MP_VERBOSE(ctx, "ohos vk: SET_BUFFER_GEOMETRY %dx%d -> %d\n", w, h, (int)r);
+}
+
+static void ohos_vk_uninit(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    ra_vk_ctx_uninit(ctx);
+    mpvk_uninit(&p->vk);
+    /* OHNativeWindow is owned by XComponent; do not destroy. */
+    p->native_window = NULL;
+}
+
+static bool ohos_vk_init(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv = talloc_zero(ctx, struct priv);
+    struct mpvk_ctx *vk = &p->vk;
+    int msgl = ctx->opts.probing ? MSGL_V : MSGL_ERR;
+
+    void *window = NULL;
+    if (!vo_ohos_native_window(ctx->vo, &window)) {
+        MP_FATAL(ctx, "ohos Vulkan requires --wid with a valid OHNativeWindow pointer.\n");
+        goto fail;
+    }
+    p->native_window = window;
+
+    if (!mpvk_init(vk, ctx, VK_OHOS_SURFACE_EXTENSION_NAME))
+        goto fail;
+
+    VkInstance inst = vk->vkinst->instance;
+    PFN_vkCreateSurfaceOHOS create_surface = get_create_surface_ohos(inst);
+    if (!create_surface) {
+        MP_MSG(ctx, msgl, "vkCreateSurfaceOHOS not available (VK_OHOS_surface)\n");
+        goto fail;
+    }
+
+    VkSurfaceCreateInfoOHOS info = {
+        .sType = VK_STRUCTURE_TYPE_SURFACE_CREATE_INFO_OHOS,
+        .window = p->native_window,
+    };
+
+    struct ra_ctx_params params = {0};
+
+    VkResult res = create_surface(inst, &info, NULL, &vk->surface);
+    if (res != VK_SUCCESS) {
+        MP_MSG(ctx, msgl, "Failed creating OHOS Vulkan surface (%d)\n", (int)res);
+        goto fail;
+    }
+
+    if (!ra_vk_ctx_init(ctx, vk, params, VK_PRESENT_MODE_FIFO_KHR))
+        goto fail;
+
+    return true;
+fail:
+    ohos_vk_uninit(ctx);
+    return false;
+}
+
+static bool ohos_vk_reconfig(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    int w, h;
+    if (!vo_ohos_surface_size(ctx->vo, &w, &h))
+        return false;
+
+    ohos_apply_surface_geometry(ctx, p->native_window, w, h);
+    ra_vk_ctx_resize(ctx, w, h);
+    return true;
+}
+
+static int ohos_vk_control(struct ra_ctx *ctx, int *events, int request, void *arg)
+{
+    return VO_NOTIMPL;
+}
+
+const struct ra_ctx_fns ra_ctx_vulkan_ohos = {
+    .type           = "vulkan",
+    .name           = "ohosvk",
+    .description    = "OpenHarmony/Vulkan",
+    .reconfig       = ohos_vk_reconfig,
+    .control        = ohos_vk_control,
+    .init           = ohos_vk_init,
+    .uninit         = ohos_vk_uninit,
+};
