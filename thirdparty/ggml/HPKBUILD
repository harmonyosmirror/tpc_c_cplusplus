pkgname=ggml

pkgver=0.9.4

pkgrel=0

pkgdesc="GGML is a tensor library for machine learning, designed for performance and flexibility."

url="https://github.com/ggml-org/ggml"

archs=("arm64-v8a" "armeabi-v7a")

license=("MIT")

depends=()

makedepends=()

source="https://codeload.github.com/ggml-org/$pkgname/zip/refs/tags/v$pkgver"

autounpack=true

downloadpackage=true

patchflag=true

builddir=$pkgname-${pkgver}

packagename=$builddir.zip

prepare() {
    
    mkdir -p $builddir/$ARCH-build
    
    if $patchflag
    then
        cd $builddir
        
        
        patch -p1 -l < `pwd`/../ggml_oh_test.patch
        
        patchflag=false
        
        cd $OLDPWD
    fi
}

build() {
    cd $builddir
    
    echo "为架构 $ARCH 启用静态编译..."
    
    export CFLAGS="-static"
    export CXXFLAGS="-static" 
    export LDFLAGS="-static"
    
    ${OHOS_SDK}/native/build-tools/cmake/bin/cmake "$@" \
        -DOHOS_ARCH=$ARCH \
        -DBUILD_SHARED_LIBS=OFF \
        -DBUILD_STATIC_LIBS=ON \
        -DGGML_BUILD_TESTS=ON \
        -DGGML_BUILD_EXAMPLES=ON \
        -DGGML_OPENMP=OFF \
        -DOPENMP=OFF \
        -DCMAKE_C_FLAGS="$CFLAGS" \
        -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
        -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS" \
        -B$ARCH-build -S./ -L > $buildlog 2>&1
        
    $MAKE VERBOSE=1 -C $ARCH-build >> $buildlog 2>&1
    
    echo "=== 检查 $ARCH 静态编译结果 ==="
    find $ARCH-build -type f \( -name "test-*" -o -name "example-*" \) ! -name "*.o" ! -name "*.d" ! -name "*.cmake" -exec sh -c '
        for file; do
            if [ -x "$file" ] || file "$file" | grep -q "ELF.*executable"; then
                echo "可执行文件: $(basename "$file")"
                file "$file"
            fi
        done
    ' _ {} +
    
    ret=$?
    cd $OLDPWD
    return $ret
}

package() {
    
    cd $builddir
    
    $MAKE VERBOSE=1 -C $ARCH-build install >> $buildlog 2>&1
    
    ret=$?
    
    cd $OLDPWD
    
    return $ret
}

check() {
    
    echo "The test must be on an OpenHarmony device!"
    
    
}

cleanbuild(){
    
    rm -rf ${PWD}/$builddir #${PWD}/$packagename
}