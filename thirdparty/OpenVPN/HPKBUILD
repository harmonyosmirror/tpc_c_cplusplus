pkgname=OpenVPN
pkgver=2.7_rc4
pkgrel=0
pkgdesc="OpenVPN is an open-source virtual private network (VPN) software with DCO support."
url="https://github.com/OpenVPN/openvpn"
archs=("armeabi-v7a" "arm64-v8a"  "x86_64")
license=("GPL-2.0 license")

depends=("openssl" "lzo" "libcap-ng" "libnl" "linux-pam")

source="https://codeload.github.com/OpenVPN/openvpn/zip/refs/tags/v$pkgver"
autounpack=true
downloadpackage=true
patchflag=true
buildtools="configure"

builddir=openvpn-${pkgver}
packagename=$builddir.zip

source envset.sh
host=

prepare() {
    if $patchflag
    then
        cd $builddir
        # 添加动态库生成支持，以及ohos设备路径不对导致的用例失败问题
        patch -p1 < ../openvpn_oh_pkg.patch
        patchflag=false
        cd $OLDPWD
    fi

    cp -arf $builddir $builddir-$ARCH-build

    if [ $ARCH == "armeabi-v7a" ]
    then
        setarm32ENV
        host=arm-linux
    elif [ $ARCH == "arm64-v8a" ]
    then
        setarm64ENV
        host=aarch64-linux
	elif [ $ARCH == "x86_64" ]
    then
        setx86_64ENV
        host=x86_64-linux
    else
        echo "${ARCH} not support"
        return -1
    fi
    return 0
}

build() {
    export CFLAGS="-D__MUSL__=1 -I${LYCIUM_ROOT}/usr/libcap-ng/${ARCH}/include -I${LYCIUM_ROOT}/usr/libnl/${ARCH}/include -I${LYCIUM_ROOT}/usr/linux-pam/${ARCH}/include -I${LYCIUM_ROOT}/usr/linux-pam/${ARCH}/include/security --sysroot=$OHOS_SDK/native/sysroot/ -fstack-protector-strong -D_FORTIFY_SOURCE=2 -O2 -ftrapv"
    export LDFLAGS="-L${LYCIUM_ROOT}/usr/libcap-ng/${ARCH}/lib -L${LYCIUM_ROOT}/usr/libnl/${ARCH}/lib -L${LYCIUM_ROOT}/usr/linux-pam/${ARCH}/lib -lcap-ng -lnl-genl-3 -lnl-3 -s"

    local current_dir=$(pwd)
    
    cd $builddir-$ARCH-build
    autoreconf -i -f > $buildlog 2>&1
	    if [ $? -ne 0 ]; then
        echo "autoreconf failed!" >> $buildlog
        return 1
    fi

    sed -i '/#define ENABLE_DCO 1/ s/^/#/' configure
    PKG_CONFIG_LIBDIR="${pkgconfigpath}" ./configure "$@" \
            --host=$host \
            --with-ohos \
            --disable-lz4 \
            --disable-plugin-auth-pam \
            --disable-dco \
            --disable-ovpn-dco \
            --disable-man \
            --enable-shared \
            --disable-static \
            --disable-doc \
            --prefix=${LYCIUM_ROOT}/usr/OpenVPN/${ARCH} > $buildlog 2>&1
    $MAKE V=1 >> $buildlog 2>&1
    sed -i '/^install-data-am:/,/^$/ s/^/#/' doc/Makefile
    # 编译测试程序
    if [ -f "tests/ntlm_support.c" ]; then
        cd tests
        $MAKE ntlm_support >> $buildlog 2>&1
    fi
    
    if [ -d "tests/unit_tests" ]; then
        echo "Compiling unit tests..." >> $buildlog 2>&1
        cd tests/unit_tests
        $MAKE >> $buildlog 2>&1
    fi
    ret=$?
    cd "$current_dir" 
    return $ret
}

package() {
    cd $builddir-$ARCH-build
    $MAKE install >> $buildlog 2>&1
    ret=$?
    cd $OLDPWD

    if [ $ret -eq 0 ]; then
        echo "Installing header files..." >> $buildlog
        mkdir -p ${LYCIUM_ROOT}/usr/OpenVPN/${ARCH}/include
        cd $builddir/src > /dev/null
        # 复制所有 .h 文件，保持 src/ 下的相对目录结构（去掉 src/ 前缀）
        find . -name "*.h" -exec cp --parents {} ${LYCIUM_ROOT}/usr/OpenVPN/${ARCH}/include/ \; >> $buildlog 2>&1
        if [ $? -ne 0 ]; then
            echo "Failed to install header files" >> $buildlog
            ret=1
        fi
        cd $OLDPWD
        # 复制生成的动态库
        mkdir -p ${LYCIUM_ROOT}/usr/OpenVPN/${ARCH}/lib
        cp -f $builddir-$ARCH-build/src/openvpn/.libs/libopenvpn.so* ${LYCIUM_ROOT}/usr/OpenVPN/${ARCH}/lib/ 2>> $buildlog
        if [ $? -ne 0 ]; then
            echo "Failed to install shared library" >> $buildlog
            ret=1
        fi
    fi

    if [ $ARCH == "armeabi-v7a" ]
    then
        unsetarm32ENV
    fi
    if [ $ARCH == "arm64-v8a" ]
    then
        unsetarm64ENV
    fi
    if [ $ARCH == "x86_64" ]
    then
        unsetx86_64ENV
    fi
    unset host
    return $ret
}

check() {
    echo "The test must be on an OpenHarmony device!"
}

cleanbuild(){
    rm -rf ${PWD}/$builddir 
    rm -rf ${PWD}/$builddir-arm64-v8a-build
    rm -rf ${PWD}/$builddir-armeabi-v7a-build
    rm -rf ${PWD}/$builddir-x86_64-build
}

