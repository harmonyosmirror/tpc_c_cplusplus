source HPKBUILD > /dev/null 2>&1
logfile=${LYCIUM_THIRDPARTY_ROOT}/${pkgname}/${pkgname}_${ARCH}_${OHOS_SDK_VER}_test.log

openharmonycheck() {
    res=0
    total=0
    pass=0
    skip=0
    fail=0

	# 构建测试目录路径
	CURRENT_DIR=$(cd "$(dirname "$0")" && pwd)
    TEST_DIR="${CURRENT_DIR}/openvpn-2.7_rc4-${ARCH}-build/tests"
    
    if [ ! -d "$TEST_DIR" ]; then
        echo "ERROR: Test directory not found: $TEST_DIR" | tee -a ${logfile}
        return 1
    fi
    
    cd "$TEST_DIR"

    # 确保 .libs 目录和符号链接存在
    mkdir -p .libs
    if [ ! -f .libs/openvpn ]; then
        cp ../../../../lycium/usr/OpenVPN/${ARCH}/sbin/openvpn .libs/
    fi

    # 设置 PATH 确保 sed 可用
    export PATH=/bin:$PATH

    # 1. t_server_null.sh
    total=$((total + 1))
	# 捕获 t_server_null.sh 的输出
    srvnull_output=$(bash ./t_server_null.sh V=1 2>&1)
	srvnull_ret=$?
	
	echo "$srvnull_output" | tee -a ${logfile}
	
    if echo "$srvnull_output" | grep -q "SKIPPING"; then
        echo "SKIP: t_server_null.sh" | tee -a ${logfile}
        skip=$((skip + 1))
	elif [ $srvnull_ret -eq 0 ]; then
		echo "PASS: t_server_null.sh" | tee -a ${logfile}
		pass=$((pass + 1))
	else
		echo "FAIL: t_server_null.sh" | tee -a ${logfile}
		fail=$((fail + 1))
		res=1
	fi

    # 2. t_client.sh
    total=$((total + 1))
	# 捕获 t_server_null.sh 的输出
    client_output=$(bash ./t_client.sh V=1 2>&1)
	client_ret=$?
	
	echo "$client_output" | tee -a ${logfile}
	
    if echo "$client_output" | grep -q "SKIPPING"; then
        echo "SKIP: t_client.sh" | tee -a ${logfile}
        skip=$((skip + 1))
	elif [ $client_ret -eq 0 ]; then
		echo "PASS: t_client.sh" | tee -a ${logfile}
		pass=$((pass + 1))
	else
		echo "FAIL: t_client.sh" | tee -a ${logfile}
		fail=$((fail + 1))
		res=1
	fi

    # 3. t_lpback.sh
    total=$((total + 1))
	# 捕获 t_lpback.sh 的输出
    lpback_output=$(bash ./t_lpback.sh V=1 2>&1)
    lpback_ret=$?
    
	echo "$lpback_output" | tee -a ${logfile}
	
    if echo "$lpback_output" | grep -q "SKIPPING"; then
        echo "SKIP: t_lpback.sh" | tee -a ${logfile}
        skip=$((skip + 1))
	elif [ $lpback_ret -eq 0 ]; then
        echo "PASS: t_lpback.sh" | tee -a ${logfile}
        pass=$((pass + 1))
    else
        echo "FAIL: t_lpback.sh" | tee -a ${logfile}
        fail=$((fail + 1))
        res=1
    fi

    # 4. t_cltsrv.sh
    total=$((total + 1))
	# 捕获 t_cltsrv.sh 的输出
    cltsrv_output=$(bash ./t_cltsrv.sh V=1 2>&1)
    cltsrv_ret=$?
	
	echo "$cltsrv_output" | tee -a ${logfile}
    
    if echo "$cltsrv_output" | grep -q "SKIPPING"; then
        echo "SKIP: t_cltsrv.sh" | tee -a ${logfile}
        skip=$((skip + 1))
	elif [ $cltsrv_ret -eq 0 ]; then
        echo "PASS: t_cltsrv.sh" | tee -a ${logfile}
        pass=$((pass + 1))
    else
        echo "FAIL: t_cltsrv.sh" | tee -a ${logfile}
        fail=$((fail + 1))
        res=1
    fi

    # 5. t_net.sh
    total=$((total + 1))
	
	# 捕获 t_net.sh 的输出
    net_output=$(bash ./t_net.sh V=1 2>&1)
    net_ret=$?
	
	echo "$net_output" | tee -a ${logfile}
	
    if echo "$net_output" | grep -q "SKIPPING"; then
        echo "SKIP: t_net.sh" | tee -a ${logfile}
        skip=$((skip + 1))
    elif [ $net_ret -eq 0 ]; then
		echo "PASS: t_net.sh" | tee -a ${logfile}
		pass=$((pass + 1))
	else
		echo "FAIL: t_net.sh" | tee -a ${logfile}
		fail=$((fail + 1))
		res=1
    fi

    # 输出汇总信息
    echo "============================================================================" | tee -a ${logfile}
    echo "Testsuite summary for OpenVPN ${pkgver} System Tests" | tee -a ${logfile}
    echo "============================================================================" | tee -a ${logfile}
    echo "# TOTAL: $total" | tee -a ${logfile}
    echo "# PASS:  $pass" | tee -a ${logfile}
    echo "# SKIP:  $skip" | tee -a ${logfile}
    echo "# FAIL:  $fail" | tee -a ${logfile}
    echo "# XFAIL: 0" | tee -a ${logfile}
    echo "# XPASS: 0" | tee -a ${logfile}
    echo "# ERROR: 0" | tee -a ${logfile}
    echo "============================================================================" | tee -a ${logfile}

    return $res
}
