pkgname=xlnt
pkgver=1.5.0
pkgrel=1
archs=("arm64-v8a" "armeabi-v7a" "x86_64")
url="https://github.com/tfussell/xlnt"
license=("MIT")
source="https://github.com/tfussell/$pkgname/archive/refs/tags/v$pkgver.tar.gz"
makedepends=("cmake")
depends=()
buildtools=("cmake")

builddir=xlnt-1.5.0
packagename=xlnt-1.5.0.tar.gz

downloadpackage=true
autounpack=true

prepare() {
    cd $builddir
    # 移除 build2 的 version 文件（无扩展名），避免与 OHOS libcxx <version> 头文件冲突
    mv third-party/libstudxml/version third-party/libstudxml/version.txt
    # 生成 libstudxml/version.hxx（GitHub archive 中为空文件，需填充版本宏）
    cat > third-party/libstudxml/libstudxml/version.hxx << 'VEOF'
#ifndef LIBSTUDXML_VERSION
#define LIBSTUDXML_VERSION       999999999508ULL
#define LIBSTUDXML_VERSION_STR   "1.1.0-b.8"
#define LIBSTUDXML_VERSION_ID    "1.1.0b8"
#define LIBSTUDXML_VERSION_MAJOR 1
#define LIBSTUDXML_VERSION_MINOR 1
#define LIBSTUDXML_VERSION_PATCH 0
#define LIBSTUDXML_PRE_RELEASE   "b.8"
#define LIBSTUDXML_SNAPSHOT      0ULL
#define LIBSTUDXML_SNAPSHOT_ID   ""
#endif
VEOF
}

build() {
    cd $builddir
    ${OHOS_SDK}/native/build-tools/cmake/bin/cmake "$@" \
        -B$ARCH-build -S./ \
        -DTESTS=ON  # 仓库自带测试用例(CTest + 自定义test_suite)，必须启用
    make -j4 $ARCH-build >> `pwd`/$ARCH-build/build.log 2>&1
    ret=$?
    cd $OLDPWD
    return $ret
}

package() {
    cd $builddir
    make -C $ARCH-build install >> `pwd`/$ARCH-build/build.log 2>&1
    cd $OLDPWD
}

check() {
    echo "The test must be on an OpenHarmony device!"
}

cleanbuild() {
    rm -rf ${PWD}/$builddir
}