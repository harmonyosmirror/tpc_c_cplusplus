diff --git a/src/net/quic/test/crypto_test.cc b/src/net/quic/test/crypto_test.cc
new file mode 100644
index 0000000..05ec145
--- /dev/null
+++ b/src/net/quic/test/crypto_test.cc
@@ -0,0 +1,43 @@
+#include <cstdint>
+#include "test_framework.h"
+
+TEST(Crypto_HashBasic) {
+  uint32_t input = 0x12345678;
+  uint32_t hash = input ^ 0xFFFFFFFF;
+  EXPECT_NE(input, hash);
+  return true;
+}
+
+TEST(Crypto_KeySize) {
+  uint32_t aes128_key_size = 16;
+  uint32_t aes256_key_size = 32;
+  EXPECT_EQ(aes256_key_size, aes128_key_size * 2);
+  EXPECT_TRUE(aes128_key_size < aes256_key_size);
+  return true;
+}
+
+TEST(Crypto_Nonce) {
+  uint64_t nonce = 0;
+  nonce++;
+  EXPECT_EQ(nonce, 1u);
+  nonce += 100;
+  EXPECT_EQ(nonce, 101u);
+  return true;
+}
+
+TEST(Crypto_BlockSize) {
+  uint32_t block_size = 16;
+  uint32_t data_size = 40;
+  uint32_t num_blocks = (data_size + block_size - 1) / block_size;
+  EXPECT_EQ(num_blocks, 3u);
+  return true;
+}
+
+TEST(Crypto_RandomRange) {
+  uint32_t min = 100;
+  uint32_t max = 200;
+  uint32_t range = max - min;
+  EXPECT_EQ(range, 100u);
+  EXPECT_TRUE(min < max);
+  return true;
+}
diff --git a/src/net/quic/test/data_structures_test.cc b/src/net/quic/test/data_structures_test.cc
new file mode 100644
index 0000000..b79a87c
--- /dev/null
+++ b/src/net/quic/test/data_structures_test.cc
@@ -0,0 +1,60 @@
+#include <cstdint>
+#include <string>
+#include <vector>
+#include "test_framework.h"
+
+TEST(DataStructures_ArrayAccess) {
+  int arr[5] = {1, 2, 3, 4, 5};
+  EXPECT_EQ(arr[0], 1);
+  EXPECT_EQ(arr[4], 5);
+  EXPECT_EQ(arr[2], 3);
+  return true;
+}
+
+TEST(DataStructures_VectorOperations) {
+  std::vector<int> vec;
+  vec.push_back(10);
+  vec.push_back(20);
+  vec.push_back(30);
+  EXPECT_EQ(vec.size(), 3u);
+  vec.pop_back();
+  EXPECT_EQ(vec.size(), 2u);
+  EXPECT_EQ(vec.back(), 20);
+  return true;
+}
+
+TEST(DataStructures_StringConcat) {
+  std::string hello = "Hello";
+  std::string world = "World";
+  std::string combined = hello + " " + world;
+  EXPECT_EQ(combined, "Hello World");
+  EXPECT_EQ(combined.length(), 11u);
+  return true;
+}
+
+TEST(DataStructures_StringFind) {
+  std::string text = "The quick brown fox";
+  size_t pos = text.find("quick");
+  EXPECT_EQ(pos, 4u);
+  pos = text.find("dog");
+  EXPECT_EQ(pos, std::string::npos);
+  return true;
+}
+
+TEST(DataStructures_IntegerLimits) {
+  uint32_t max_uint32 = 0xFFFFFFFF;
+  int32_t max_int32 = 0x7FFFFFFF;
+  int32_t min_int32 = 0x80000000;
+  EXPECT_TRUE(max_uint32 > max_int32);
+  EXPECT_TRUE(min_int32 < 0);
+  return true;
+}
+
+TEST(DataStructures_BitOperations) {
+  uint32_t val = 0x0000FFFF;
+  EXPECT_EQ(val << 16, 0xFFFF0000u);
+  EXPECT_EQ(val >> 8, 0x000000FFu);
+  EXPECT_EQ(val & 0x00FF00FF, 0x000000FFu);
+  EXPECT_EQ(val | 0xFFFF0000, 0xFFFFFFFFu);
+  return true;
+}
