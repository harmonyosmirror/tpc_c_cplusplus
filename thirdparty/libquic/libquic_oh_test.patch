diff --git a/src/net/quic/test/congestion_control_test.cc b/src/net/quic/test/congestion_control_test.cc
new file mode 100644
index 0000000..800c0ff
--- /dev/null
+++ b/src/net/quic/test/congestion_control_test.cc
@@ -0,0 +1,42 @@
+#include <cstdint>
+#include "test_framework.h"
+
+TEST(CongestionControl_RttCalculation) {
+  uint64_t rtt1 = 100;
+  uint64_t rtt2 = 200;
+  EXPECT_EQ((rtt1 + rtt2) / 2, 150u);
+  EXPECT_TRUE(rtt1 < rtt2);
+  return true;
+}
+
+TEST(CongestionControl_Bandwidth) {
+  uint64_t bytes = 1000;
+  uint64_t time_ms = 10;
+  uint64_t bandwidth = bytes / time_ms;
+  EXPECT_EQ(bandwidth, 100u);
+  return true;
+}
+
+TEST(CongestionControl_WindowSize) {
+  uint32_t base_window = 1000;
+  uint32_t multiplier = 2;
+  EXPECT_EQ(base_window * multiplier, 2000u);
+  EXPECT_EQ(base_window + base_window, 2000u);
+  return true;
+}
+
+TEST(CongestionControl_PacketLoss) {
+  uint32_t total_packets = 100;
+  uint32_t lost_packets = 5;
+  double loss_rate = (double)lost_packets / total_packets;
+  EXPECT_TRUE(loss_rate == 0.05);
+  return true;
+}
+
+TEST(CongestionControl_Threshold) {
+  uint32_t current = 500;
+  uint32_t threshold = 1000;
+  EXPECT_TRUE(current < threshold);
+  EXPECT_FALSE(current > threshold);
+  return true;
+}
