diff --git a/src/net/quic/test/test_framework.h b/src/net/quic/test/test_framework.h
new file mode 100644
index 0000000..76f244c
--- /dev/null
+++ b/src/net/quic/test/test_framework.h
@@ -0,0 +1,94 @@
+#ifndef NET_QUIC_TEST_TEST_FRAMEWORK_H_
+#define NET_QUIC_TEST_TEST_FRAMEWORK_H_
+
+#include <iostream>
+#include <string>
+#include <vector>
+
+namespace test {
+
+class TestSuite {
+ public:
+  static TestSuite& GetInstance() {
+    static TestSuite instance;
+    return instance;
+  }
+
+  void AddTest(const std::string& name, bool (*test_func)()) {
+    tests_.push_back({name, test_func});
+  }
+
+  int RunAll() {
+    int passed = 0;
+    int failed = 0;
+
+    std::cout << "[==========] Running " << tests_.size() << " tests.\n";
+
+    for (const auto& test : tests_) {
+      std::cout << "[ RUN      ] " << test.name << "\n";
+      bool result = test.func();
+      if (result) {
+        std::cout << "[       OK ] " << test.name << "\n";
+        passed++;
+      } else {
+        std::cout << "[  FAILED  ] " << test.name << "\n";
+        failed++;
+      }
+    }
+
+    std::cout << "[==========] " << tests_.size() << " tests ran.\n";
+    std::cout << "[  PASSED  ] " << passed << " tests.\n";
+    if (failed > 0) {
+      std::cout << "[  FAILED  ] " << failed << " tests.\n";
+    }
+
+    return failed;
+  }
+
+ private:
+  TestSuite() {}
+  ~TestSuite() {}
+
+  struct Test {
+    std::string name;
+    bool (*func)();
+  };
+
+  std::vector<Test> tests_;
+};
+
+#define TEST(name) \
+  bool test_##name(); \
+  static bool test_register_##name = []() { \
+    test::TestSuite::GetInstance().AddTest(#name, test_##name); \
+    return true; \
+  }(); \
+  bool test_##name()
+
+#define EXPECT_EQ(a, b) \
+  if ((a) != (b)) { \
+    std::cerr << "Expected: " << (a) << ", Got: " << (b) << "\n"; \
+    return false; \
+  }
+
+#define EXPECT_NE(a, b) \
+  if ((a) == (b)) { \
+    std::cerr << "Expected not equal: " << (a) << " == " << (b) << "\n"; \
+    return false; \
+  }
+
+#define EXPECT_TRUE(a) \
+  if (!(a)) { \
+    std::cerr << "Expected true, got false\n"; \
+    return false; \
+  }
+
+#define EXPECT_FALSE(a) \
+  if ((a)) { \
+    std::cerr << "Expected false, got true\n"; \
+    return false; \
+  }
+
+}  // namespace test
+
+#endif  // NET_QUIC_TEST_TEST_FRAMEWORK_H_
diff --git a/src/net/quic/test/util_test.cc b/src/net/quic/test/util_test.cc
new file mode 100644
index 0000000..a9ed565
--- /dev/null
+++ b/src/net/quic/test/util_test.cc
@@ -0,0 +1,388 @@
+#include <cstdint>
+#include <string>
+#include <vector>
+#include "net/quic/core/quic_bandwidth.h"
+#include "net/quic/core/quic_time.h"
+#include "net/quic/core/quic_utils.h"
+#include "net/quic/core/quic_types.h"
+#include "test_framework.h"
+
+TEST(QuicBandwidth_FromBytesPerSecond) {
+  auto bandwidth = net::QuicBandwidth::FromBytesPerSecond(1000);
+  EXPECT_EQ(bandwidth.ToBytesPerSecond(), 1000LL);
+  return true;
+}
+
+TEST(QuicBandwidth_FromBitsPerSecond) {
+  auto bandwidth = net::QuicBandwidth::FromBitsPerSecond(8000);
+  EXPECT_EQ(bandwidth.ToBytesPerSecond(), 1000LL);
+  return true;
+}
+
+TEST(QuicBandwidth_FromKBitsPerSecond) {
+  auto bandwidth = net::QuicBandwidth::FromKBitsPerSecond(100);
+  EXPECT_EQ(bandwidth.ToKBitsPerSecond(), 100LL);
+  EXPECT_EQ(bandwidth.ToBitsPerSecond(), 100000LL);
+  return true;
+}
+
+TEST(QuicBandwidth_FromKBytesPerSecond) {
+  auto bandwidth = net::QuicBandwidth::FromKBytesPerSecond(100);
+  EXPECT_EQ(bandwidth.ToKBytesPerSecond(), 100LL);
+  EXPECT_EQ(bandwidth.ToBytesPerSecond(), 100000LL);
+  return true;
+}
+
+TEST(QuicBandwidth_MultiplyFloat) {
+  auto bandwidth = net::QuicBandwidth::FromBytesPerSecond(1000);
+  auto result = bandwidth * 2.0f;
+  EXPECT_EQ(result.ToBytesPerSecond(), 2000LL);
+  return true;
+}
+
+TEST(QuicBandwidth_MultiplyByFloatFactor) {
+  auto bandwidth = net::QuicBandwidth::FromBytesPerSecond(1000);
+  auto result = bandwidth * 0.5f;
+  EXPECT_EQ(result.ToBytesPerSecond(), 500LL);
+  return true;
+}
+
+TEST(QuicBandwidth_Comparison) {
+  auto b1 = net::QuicBandwidth::FromBytesPerSecond(1000);
+  auto b2 = net::QuicBandwidth::FromBytesPerSecond(2000);
+  EXPECT_TRUE(b1 < b2);
+  EXPECT_TRUE(b2 > b1);
+  EXPECT_TRUE(b1 <= b2);
+  EXPECT_TRUE(b2 >= b1);
+  EXPECT_FALSE(b1 == b2);
+  EXPECT_TRUE(b1 != b2);
+  return true;
+}
+
+TEST(QuicBandwidth_Add) {
+  auto b1 = net::QuicBandwidth::FromBytesPerSecond(1000);
+  auto b2 = net::QuicBandwidth::FromBytesPerSecond(2000);
+  auto result = b1 + b2;
+  EXPECT_EQ(result.ToBytesPerSecond(), 3000LL);
+  return true;
+}
+
+TEST(QuicBandwidth_Subtract) {
+  auto b1 = net::QuicBandwidth::FromBytesPerSecond(3000);
+  auto b2 = net::QuicBandwidth::FromBytesPerSecond(1000);
+  auto result = b1 - b2;
+  EXPECT_EQ(result.ToBytesPerSecond(), 2000LL);
+  return true;
+}
+
+TEST(QuicBandwidth_Zero) {
+  auto zero = net::QuicBandwidth::Zero();
+  EXPECT_EQ(zero.ToBytesPerSecond(), 0LL);
+  EXPECT_TRUE(zero.IsZero());
+  return true;
+}
+
+TEST(QuicBandwidth_Infinite) {
+  auto infinite = net::QuicBandwidth::Infinite();
+  EXPECT_FALSE(infinite.IsZero());
+  EXPECT_TRUE(infinite > net::QuicBandwidth::FromBytesPerSecond(0));
+  return true;
+}
+
+TEST(QuicBandwidth_FromBytesAndTimeDelta) {
+  auto delta = net::QuicTime::Delta::FromMilliseconds(1000);
+  auto bandwidth = net::QuicBandwidth::FromBytesAndTimeDelta(1000, delta);
+  EXPECT_EQ(bandwidth.ToBytesPerSecond(), 1000LL);
+  return true;
+}
+
+TEST(QuicBandwidth_ToBytesPerPeriod) {
+  auto bandwidth = net::QuicBandwidth::FromBytesPerSecond(1000);
+  auto period = net::QuicTime::Delta::FromMilliseconds(500);
+  EXPECT_EQ(bandwidth.ToBytesPerPeriod(period), 500u);
+  return true;
+}
+
+TEST(QuicTime_DeltaOperations) {
+  auto delta1 = net::QuicTime::Delta::FromMilliseconds(100);
+  auto delta2 = net::QuicTime::Delta::FromMilliseconds(200);
+  EXPECT_EQ((delta1 + delta2).ToMilliseconds(), 300LL);
+  EXPECT_EQ((delta2 - delta1).ToMilliseconds(), 100LL);
+  EXPECT_EQ((delta1 * 2).ToMilliseconds(), 200LL);
+  return true;
+}
+
+TEST(QuicTime_DeltaComparison) {
+  auto delta1 = net::QuicTime::Delta::FromMilliseconds(100);
+  auto delta2 = net::QuicTime::Delta::FromMilliseconds(200);
+  EXPECT_TRUE(delta1 < delta2);
+  EXPECT_TRUE(delta2 > delta1);
+  EXPECT_TRUE(delta1 <= delta2);
+  EXPECT_TRUE(delta2 >= delta1);
+  EXPECT_EQ(delta1, net::QuicTime::Delta::FromMilliseconds(100));
+  EXPECT_FALSE(delta1 == delta2);
+  return true;
+}
