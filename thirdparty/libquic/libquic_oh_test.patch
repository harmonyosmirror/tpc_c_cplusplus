+TEST(VectorOperations) {
+  std::vector<int> vec;
+  EXPECT_EQ(vec.size(), 0u);
+  
+  vec.push_back(1);
+  vec.push_back(2);
+  vec.push_back(3);
+  
+  EXPECT_EQ(vec.size(), 3u);
+  EXPECT_EQ(vec[0], 1);
+  EXPECT_EQ(vec[1], 2);
+  EXPECT_EQ(vec[2], 3);
+  
+  vec.pop_back();
+  EXPECT_EQ(vec.size(), 2u);
+  EXPECT_EQ(vec.back(), 2);
+  
+  vec.clear();
+  EXPECT_EQ(vec.size(), 0u);
+  return true;
+}
+
+TEST(VectorIteration) {
+  std::vector<int> vec = {1, 2, 3, 4, 5};
+  int sum = 0;
+  for (int val : vec) {
+    sum += val;
+  }
+  EXPECT_EQ(sum, 15);
+  return true;
+}
+
+TEST(VectorSort) {
+  std::vector<int> vec = {3, 1, 4, 1, 5, 9, 2, 6};
+  std::sort(vec.begin(), vec.end());
+  EXPECT_EQ(vec[0], 1);
+  EXPECT_EQ(vec[1], 1);
+  EXPECT_EQ(vec[2], 2);
+  EXPECT_EQ(vec.back(), 9);
+  return true;
+}
+
+TEST(VectorFind) {
+  std::vector<int> vec = {10, 20, 30, 40, 50};
+  auto it = std::find(vec.begin(), vec.end(), 30);
+  EXPECT_TRUE(it != vec.end());
+  EXPECT_EQ(*it, 30);
+  
+  it = std::find(vec.begin(), vec.end(), 100);
+  EXPECT_TRUE(it == vec.end());
+  return true;
+}
+
+TEST(VectorResize) {
+  std::vector<int> vec(5, 0);
+  EXPECT_EQ(vec.size(), 5u);
+  vec.resize(10);
+  EXPECT_EQ(vec.size(), 10u);
+  vec.resize(3);
+  EXPECT_EQ(vec.size(), 3u);
+  return true;
+}
+
+TEST(VectorInsert) {
+  std::vector<int> vec = {1, 3, 4};
+  vec.insert(vec.begin() + 1, 2);
+  EXPECT_EQ(vec.size(), 4u);
+  EXPECT_EQ(vec[0], 1);
+  EXPECT_EQ(vec[1], 2);
+  EXPECT_EQ(vec[2], 3);
+  EXPECT_EQ(vec[3], 4);
+  return true;
+}
+
+TEST(VectorErase) {
+  std::vector<int> vec = {1, 2, 3, 4, 5};
+  vec.erase(vec.begin() + 2);
+  EXPECT_EQ(vec.size(), 4u);
+  EXPECT_EQ(vec[0], 1);
+  EXPECT_EQ(vec[1], 2);
+  EXPECT_EQ(vec[2], 4);
+  EXPECT_EQ(vec[3], 5);
+  return true;
+}
+
+TEST(VectorSwap) {
+  std::vector<int> vec1 = {1, 2, 3};
+  std::vector<int> vec2 = {4, 5, 6};
+  vec1.swap(vec2);
+  EXPECT_EQ(vec1[0], 4);
+  EXPECT_EQ(vec2[0], 1);
+  return true;
+}
