pkgname=libmp4
pkgver=c49afb1
pkgrel=0
pkgdesc="MP4 file library for ISO base media file format (ISO/IEC 14496-12)"
url="https://github.com/Akaaba/libmp4"
archs=("armeabi-v7a" "arm64-v8a" "x86_64")
license=("BSD-3-Clause")
depends=()
makedepends=()

source="https://github.com/Akaaba/libmp4/archive/c49afb1beda256acc16f4bbb7c8e65fb54fa2acf.tar.gz"

downloadpackage=true
autounpack=true
buildtools="make"

builddir=libmp4-c49afb1beda256acc16f4bbb7c8e65fb54fa2acf
packagename=libmp4-c49afb1beda256acc16f4bbb7c8e65fb54fa2acf.tar.gz

source envset.sh

prepare() {
    if [ "$ARCH" = "armeabi-v7a" ]; then
        setarm32ENV
    elif [ "$ARCH" = "arm64-v8a" ]; then
        setarm64ENV
    elif [ "$ARCH" = "x86_64" ]; then
        setx86_64ENV
    fi

    # Generate Makefile for OpenHarmony adaptation
    cat > "$builddir/Makefile" << 'MAKEFILE_EOF'
# Makefile for libmp4 OpenHarmony adaptation
# Builds both shared (.so) and static (.a) libraries

PREFIX  ?= /usr/local
LIBDIR    = $(PREFIX)/lib
INCLUDEDIR = $(PREFIX)/include
BINDIR    = $(PREFIX)/bin

SRCS = src/mp4_box.c src/mp4_track.c src/mp4_demux.c src/mp4_log.c
OBJS = $(SRCS:.c=.o)

TEST_SRCS = test/mp4_demux_test.c
TEST_TARGET = mp4_demux_test

override CFLAGS += -I./include -I./src -fPIC -include include/ulog_compat.h

SHARED_TARGET = libmp4.so
STATIC_TARGET = libmp4.a

all: $(SHARED_TARGET) $(STATIC_TARGET) $(TEST_TARGET)

$(SHARED_TARGET): $(OBJS)
	$(CC) -shared -Wl,-soname,libmp4.so -o $@ $^

$(STATIC_TARGET): $(OBJS)
	$(AR) rcs $@ $^
	$(RANLIB) $@

$(TEST_TARGET): $(TEST_SRCS) $(STATIC_TARGET)
	$(CC) $(CFLAGS) -o $@ $< $(STATIC_TARGET)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

install: $(SHARED_TARGET) $(STATIC_TARGET) $(TEST_TARGET)
	mkdir -p $(DESTDIR)$(LIBDIR)
	mkdir -p $(DESTDIR)$(INCLUDEDIR)
	mkdir -p $(DESTDIR)$(BINDIR)
	install -m 755 $(SHARED_TARGET)  $(DESTDIR)$(LIBDIR)/
	install -m 644 $(STATIC_TARGET)  $(DESTDIR)$(LIBDIR)/
	install -m 644 include/libmp4.h  $(DESTDIR)$(INCLUDEDIR)/
	install -m 644 include/list.h    $(DESTDIR)$(INCLUDEDIR)/
	install -m 755 $(TEST_TARGET)    $(DESTDIR)$(BINDIR)/

clean:
	rm -f $(OBJS) $(SHARED_TARGET) $(STATIC_TARGET) $(TEST_TARGET)

.PHONY: all install clean
MAKEFILE_EOF

    # Generate futils/futils.h: stub forwarding to list.h.
    # The upstream src/mp4.h includes <futils/futils.h> from Parrot's libfutils.
    # We provide a minimal stub so libmp4 builds without that external dependency.
    mkdir -p "$builddir/include/futils"
    cat > "$builddir/include/futils/futils.h" << 'FUTILS_EOF'
/*
 * futils/futils.h - OpenHarmony adaptation stub
 * libmp4's src/mp4.h includes this header from Parrot's libfutils package.
 * We provide a minimal stub that forwards to list.h, which supplies the
 * list_node struct and all list operations that libmp4 actually uses.
 * No upstream source files are modified.
 */
#ifndef FUTILS_FUTILS_H
#define FUTILS_FUTILS_H

#include <list.h>

#endif /* FUTILS_FUTILS_H */
FUTILS_EOF

    # Generate ulog_compat.h: stubs for ULOG macros used unconditionally in
    # mp4_box.c and mp4_demux.c outside the BUILD_LIBULOG guard.
    # Injected via CFLAGS -include; no upstream source files are modified.
    cat > "$builddir/include/ulog_compat.h" << 'ULOG_EOF'
/*
 * ulog_compat.h - OpenHarmony adaptation: stubs for ULOG macros
 *
 * mp4_box.c and mp4_demux.c use ULOG_PRI / ULOG_DEBUG unconditionally
 * outside the BUILD_LIBULOG guard. This header provides minimal stubs
 * so the library compiles without the optional libulog dependency.
 *
 * Injected via Makefile CFLAGS: -include include/ulog_compat.h
 * No upstream source files are modified.
 */
#ifndef ULOG_COMPAT_H
#define ULOG_COMPAT_H

#ifndef ULOG_DEBUG
#define ULOG_DEBUG 0
#endif

#ifndef ULOG_PRI
#include <stdio.h>
#define ULOG_PRI(level, fmt, ...) fprintf(stderr, fmt, ##__VA_ARGS__)
#endif

#endif /* ULOG_COMPAT_H */
ULOG_EOF

    # Generate list.h: double chained list implementation required by libmp4.
    # The upstream tarball does not bundle this header; it is provided here
    # so the build is self-contained without patching the source.
    cat > "$builddir/include/list.h" << 'LIST_EOF'
/******************************************************************************
