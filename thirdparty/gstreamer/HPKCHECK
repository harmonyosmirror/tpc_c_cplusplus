source HPKBUILD > /dev/null 2>&1
logfile=${LYCIUM_THIRDPARTY_ROOT}/${pkgname}/${pkgname}_${ARCH}_${OHOS_SDK_VER}_test.log

openharmonycheck() {
    res=0
    cp $builddir/meson.build $builddir/${ARCH}-build/subprojects/gstreamer/tests/check/
    cd $builddir/${ARCH}-build/subprojects/gstreamer/tests/check

    export GST_PLUGIN_SYSTEM_PATH=""
    export GST_STATE_IGNORE_ELEMENTS=""
    export TZ=UTC
    export GST_PLUGIN_PATH="../../plugins/"
    export GST_PLUGIN_SCANNER="../../libs/gst/helpers/gst-plugin-scanner"
    export GST_PARSE_STRICT=1

    for file in ./*; do
        if [[ -f "$file" && -x "$file" && ! "$file" == *.registry ]]; then
            if [[ "$file" == "./$(basename "$0")" ]]; then
                continue
            fi
            
            filename=$(basename "$file")
            echo "===== Testing: $filename =====" >> ${logfile} 2>&1
            
            "./$filename" >> ${logfile} 2>&1
            exit_code=$?
            
            if [ $exit_code -ne 0 ]; then
                echo "$filename test failed (exit code: $exit_code)" >> ${logfile} 2>&1
                res=-1
            else
                echo "$filename test pass" >> ${logfile} 2>&1
            fi
            echo "" >> ${logfile} 2>&1
        fi
    done

    cd $OLDPWD
    return $res
}
