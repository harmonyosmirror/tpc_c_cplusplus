--- a/tensorflow/lite/testing/CMakeLists.txt
+++ b/tensorflow/lite/testing/CMakeLists.txt
@@ -0,0 +1,127 @@
+#
+# CMake build for portable unit tests under tensorflow/lite/testing.
+# Bazel remains the full source of truth; this covers the lightweight cc_test
+# targets that build with the standalone tensorflow-lite CMake graph.
+#
+# CMake target names use prefix tflite_lite_testing_ to avoid clashing with
+# tensorflow/lite/kernels/*_test when TFLITE_KERNEL_TEST is also ON.
+#
+
+if(NOT TARGET GTest::gtest_main)
+  find_package(googletest REQUIRED)
+endif()
+
+# ---- Small static libs (aligned with //tensorflow/lite/testing:BUILD) ----
+
+add_library(tflite_testing_tokenize STATIC "${CMAKE_CURRENT_SOURCE_DIR}/tokenize.cc")
+target_include_directories(tflite_testing_tokenize PUBLIC "${TENSORFLOW_SOURCE_DIR}")
+target_link_libraries(tflite_testing_tokenize PUBLIC tensorflow-lite)
+
+add_library(tflite_testing_message STATIC "${CMAKE_CURRENT_SOURCE_DIR}/message.cc")
+target_include_directories(tflite_testing_message PUBLIC "${TENSORFLOW_SOURCE_DIR}")
+target_link_libraries(tflite_testing_message PUBLIC tflite_testing_tokenize tensorflow-lite)
+
+add_library(tflite_testing_split STATIC "${CMAKE_CURRENT_SOURCE_DIR}/split.cc")
+target_include_directories(tflite_testing_split PUBLIC "${TENSORFLOW_SOURCE_DIR}")
+target_link_libraries(tflite_testing_split PUBLIC tensorflow-lite)
+
+add_library(tflite_testing_join INTERFACE)
+target_include_directories(tflite_testing_join INTERFACE "${TENSORFLOW_SOURCE_DIR}")
+target_link_libraries(tflite_testing_join INTERFACE tensorflow-lite)
+
+add_library(tflite_testing_test_runner INTERFACE)
+target_include_directories(tflite_testing_test_runner INTERFACE "${TENSORFLOW_SOURCE_DIR}")
+target_link_libraries(tflite_testing_test_runner INTERFACE tensorflow-lite)
+
+# kernel_test/input_generator (no TF Core; no Flex)
+add_library(tflite_testing_input_generator STATIC
+  "${CMAKE_CURRENT_SOURCE_DIR}/kernel_test/input_generator.cc"
+)
+target_include_directories(tflite_testing_input_generator PUBLIC "${TENSORFLOW_SOURCE_DIR}")
+target_link_libraries(tflite_testing_input_generator PUBLIC
+  tflite_testing_join
+  tflite_testing_split
+  tensorflow-lite
+)
+
+add_library(tflite_testing_diff_analyzer STATIC
+  "${CMAKE_CURRENT_SOURCE_DIR}/kernel_test/diff_analyzer.cc"
+)
+target_include_directories(tflite_testing_diff_analyzer PUBLIC "${TENSORFLOW_SOURCE_DIR}")
+target_link_libraries(tflite_testing_diff_analyzer PUBLIC
+  tflite_testing_split
+  tensorflow-lite
+)
+
+# ---- cc_test equivalents (prefixed targets) ----
+
+function(_tflite_lite_testing_executable name)
+  add_executable(${name} ${ARGN})
+  target_include_directories(${name} PRIVATE "${TENSORFLOW_SOURCE_DIR}")
+  target_link_libraries(${name} PRIVATE
+    tensorflow-lite
+    GTest::gtest_main
+    GTest::gmock
+    absl::check
+    absl::log
+  )
+  set_target_properties(${name} PROPERTIES
+    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
+  )
+  add_test(
+    NAME ${name}
+    COMMAND ${name}
+    WORKING_DIRECTORY "${TENSORFLOW_SOURCE_DIR}"
+  )
+endfunction()
+
+_tflite_lite_testing_executable(tflite_lite_testing_matchers_test
+  "${CMAKE_CURRENT_SOURCE_DIR}/matchers_test.cc"
+)
+
+_tflite_lite_testing_executable(tflite_lite_testing_message_test
+  "${CMAKE_CURRENT_SOURCE_DIR}/message_test.cc"
+)
+target_link_libraries(tflite_lite_testing_message_test PRIVATE tflite_testing_message)
+
+_tflite_lite_testing_executable(tflite_lite_testing_split_test
+  "${CMAKE_CURRENT_SOURCE_DIR}/split_test.cc"
+)
+target_link_libraries(tflite_lite_testing_split_test PRIVATE tflite_testing_split)
+
+_tflite_lite_testing_executable(tflite_lite_testing_join_test
+  "${CMAKE_CURRENT_SOURCE_DIR}/join_test.cc"
+)
+target_link_libraries(tflite_lite_testing_join_test PRIVATE tflite_testing_join)
+
+_tflite_lite_testing_executable(tflite_lite_testing_tokenize_test
+  "${CMAKE_CURRENT_SOURCE_DIR}/tokenize_test.cc"
+)
+target_link_libraries(tflite_lite_testing_tokenize_test PRIVATE tflite_testing_tokenize)
+
+_tflite_lite_testing_executable(tflite_lite_testing_test_runner_test
+  "${CMAKE_CURRENT_SOURCE_DIR}/test_runner_test.cc"
+)
+target_link_libraries(tflite_lite_testing_test_runner_test PRIVATE tflite_testing_test_runner)
+
+_tflite_lite_testing_executable(tflite_lite_testing_input_generator_test
+  "${CMAKE_CURRENT_SOURCE_DIR}/kernel_test/input_generator_test.cc"
+)
+target_link_libraries(tflite_lite_testing_input_generator_test PRIVATE tflite_testing_input_generator)
+
+_tflite_lite_testing_executable(tflite_lite_testing_diff_analyzer_test
+  "${CMAKE_CURRENT_SOURCE_DIR}/kernel_test/diff_analyzer_test.cc"
+)
+target_link_libraries(tflite_lite_testing_diff_analyzer_test PRIVATE tflite_testing_diff_analyzer)
+
+# One-shot build of every lite/testing target defined in this CMake file.
+add_custom_target(lite_testing_cmake_all DEPENDS
+  tflite_lite_testing_matchers_test
+  tflite_lite_testing_message_test
+  tflite_lite_testing_split_test
+  tflite_lite_testing_join_test
+  tflite_lite_testing_tokenize_test
+  tflite_lite_testing_test_runner_test
+  tflite_lite_testing_input_generator_test
+  tflite_lite_testing_diff_analyzer_test
+)
