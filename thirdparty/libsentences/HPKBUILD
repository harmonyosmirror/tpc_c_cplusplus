pkgname=libsentences
pkgver=master
pkgrel=0
pkgdesc="libsentences is a C++ library that splits text into sentences"
url="https://github.com/fsaric/libsentences"
archs=("armeabi-v7a" "arm64-v8a" "x86_64")
