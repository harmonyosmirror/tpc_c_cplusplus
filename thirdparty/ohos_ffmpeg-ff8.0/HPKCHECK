source HPKBUILD > /dev/null 2>&1
logfile=${LYCIUM_THIRDPARTY_ROOT}/${pkgname}/${pkgname}_${ARCH}_${OHOS_SDK_VER}_test.log

openharmonycheck() {
    res=0
    cd $pkgname-$ARCH-build/$builddir
    if [ -f libavutil/tests/base64 ]
    then
        cp -f libavutil/tests/base64 tests/base64
        chmod +x tests/base64
    fi
    make fate-libavcodec \
         fate-libavutil \
         fate-libavformat \
         fate-checkasm \
         fate-lavf-audio \
         fate-lavf-container \
         fate-lavf-video \
         fate-lavf-images \
         fate-lavf-image2pipe \
         fate-api-flac \
         fate-api-threadmessage > ${logfile} 2>&1
    res=$?
    cd $OLDPWD

    return $res
}
