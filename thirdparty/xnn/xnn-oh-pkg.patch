diff -u a/atomic_shim_alias.c b/atomic_shim_alias.c
--- a/atomic_shim_alias.c	1970-01-01 08:00:00
+++ b/atomic_shim_alias.c	2026-04-24 00:00:00
@@ -0,0 +1,9 @@
+#include <stdint.h>
+
+unsigned char sync_val_compare_and_swap_1_shim(volatile unsigned char *p, unsigned char oldv, unsigned char newv) {
+    unsigned char expected = oldv;
+    __atomic_compare_exchange_n((unsigned char *)p, &expected, newv, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+    return expected;
+}
+
+__asm__(".global __sync_val_compare_and_swap_1\n__sync_val_compare_and_swap_1 = sync_val_compare_and_swap_1_shim");

