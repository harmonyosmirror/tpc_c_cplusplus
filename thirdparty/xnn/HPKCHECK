source HPKBUILD >/dev/null 2>&1
logfile="${LYCIUM_THIRDPARTY_ROOT}/${pkgname}/${pkgname}_${ARCH}_${OHOS_SDK_VER}_test.log"

openharmonycheck() {
    ARCH=$(echo "$ARCH" | tr '[:upper:]' '[:lower:]')

    cd "${builddir}/${ARCH}-build"
    chmod +x predict xnn-roc

    local MODEL="${XNN_TEST_MODEL_DIR:-model}"
    local IMAGE="${XNN_TEST_IMAGE:-data/face.png}"
    local DB="${XNN_TEST_DB:-data/test.picpac}"

    {
        echo "== xnn HPKCHECK ARCH=$ARCH =="
        ./predict "$MODEL" "$IMAGE" --mode 0
        ./xnn-roc --model "$MODEL" --db "$DB" --split_negate 0 --annotate none
        echo "xnn HPKCHECK: OK"
    } > "$logfile" 2>&1
    local ret=$?

    [ $ret -ne 0 ] && {
        mkdir -p "${LYCIUM_FAULT_PATH}/${pkgname}"
        cp -f "$logfile" "${LYCIUM_FAULT_PATH}/${pkgname}/" 2>/dev/null
    }
    cd "$OLDPWD"
    return $ret
}