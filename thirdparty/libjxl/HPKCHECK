source HPKBUILD > /dev/null 2>&1
logfile=${LYCIUM_THIRDPARTY_ROOT}/${pkgname}/${pkgname}_${ARCH}_${OHOS_SDK_VER}_test.log

openharmonycheck() {
    res=0
    export LD_LIBRARY_PATH=$(realpath ${builddir}/${ARCH}-build/lib/):$LD_LIBRARY_PATH
    
    cp -r ${builddir}/testdata ${builddir}/${ARCH}-build/lib/tests/ > ${logfile} 2>&1
    
    cd ${builddir}/${ARCH}-build/lib/tests
    test_executables=(*_test)
    total_tests=${#test_executables[@]}
    passed=0
    failed=0
    
    for test_exe in "${test_executables[@]}"; do
        if [ -x "$test_exe" ]; then
            echo "Running $test_exe ..." >> ${logfile}
            
            "./$test_exe" >> ${logfile} 2>&1
            test_res=$?
            
            if [ $test_res -eq 0 ]; then
                ((passed++))
            else
                ((failed++))
                res=$test_res  
            fi
            echo "$test_exe - Passed: $passed, Failed: $failed, Total: $total_tests" >> ${logfile} 2>&1
        fi
    done
    
    echo "Test completed. Passed: $passed, Failed: $failed, Total: $total_tests" >> ${logfile} 2>&1
 
    cd $OLDPWD                   
    return $res
}
