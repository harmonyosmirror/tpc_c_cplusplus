pkgname=libaim
pkgver=master # 库版本
pkgrel=0 # 发布号
pkgdesc="libaim is a library for C++ used to communicate with AOL's instant messaging service using the OSCAR protocol."
url="https://gitee.com/tigerz001/libaim.git"
archs=("armeabi-v7a" "arm64-v8a")
license=(LGPLv2)
makedepends=("cvs") # 构建库时的依赖工具->需要用户安装的工具
source="https://gitee.com/tigerz001/libaim/repository/archive/master.zip"


downloadpackage=true
autounpack=true
buildtools=cmake

builddir=${pkgname}
packagename=${pkgname}.zip

clonsrcflag=true
source envset.sh

TEST_EXEC="test_libaim_ohos" # 鸿蒙测试程序名
TEST_DEST_DIR="data/local/tmp/libaim_test" # 设备上的测试目录

prepare() {
    if [ -e "$pkgname-$pkgver" ]; then
        mv ${pkgname}-${pkgver} ${builddir}
    fi

    if [ $clonsrcflag == true ];then
        mv ${builddir} ${builddir}-cvs
        cvs -d ${PWD}/${builddir}-cvs co ${builddir}
        if [ $? -ne 0 ];then
            return -1
        fi
        patch -p3 < "libaim_ohos_test.patch"
        cd ${builddir}
        find . -type f \( -name "*.cpp" -o -name "*.h" \) -exec sed -i 's/byte/mybyte/g' {} \;
        sed -i '/#include <ctype.h>/a #include <string.h>' flap.cpp
        sed -i '/mask\[/,/]/{s/\b0x[0-9A-Fa-f]\+/\(char\)&/g}' aimsession.cpp
        cp ../CMakeLists.txt .
        cp ../test_aim_session.cpp .
        cp ../test_flap.cpp .
        cp ../build_test_native.sh .
        cp ../test_libaim_ohos.cpp .
        cd $OLDPWD
        clonsrcflag=false
    fi
    mkdir -p ${builddir}/${ARCH}-build

    if [ ${ARCH} == "armeabi-v7a" ]
    then
        setarm32ENV
        host=arm-linux
        support64=no
    elif [ ${ARCH} == "arm64-v8a" ]
    then
        setarm64ENV
        host=aarch64-linux
        support64=yes
    else
        echo "${ARCH} not support"
        return -1
    fi
}

build() {
    cd ${builddir}
    ${OHOS_SDK}native/build-tools/cmake/bin/cmake "$@" -DOHOS_ARCH=${ARCH} -DBUILD_OHOS_TEST=ON -DCMAKE_RUNTIME_OUTPUT_DIRECTORY=${ARCH}-build/bin -B${ARCH}-build -S./ -L > `pwd`/${ARCH}-build/build.log 2>&1
    make -C ${ARCH}-build >> `pwd`/${ARCH}-build/build.log 2>&1
    ret=$?
    cd $OLDPWD
    return $ret
}

package() {
    install_dir=${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}
    mkdir -p ${install_dir}/lib
    mkdir -p ${install_dir}/bin

    cp -af ${builddir}/${ARCH}-build/libaim_static.a ${install_dir}/lib
    cp -af ${builddir}/${ARCH}-build/libaim.so ${install_dir}/lib
    cp -arf ${builddir}/include ${install_dir}/
    cp -af ${builddir}/${ARCH}-build/bin/test_libaim_ohos ${install_dir}/bin
    rm -rf ${install_dir}/include/CVS
    rm -rf ${install_dir}/include/htmlparser.h
}

check() {
    echo "The test must be on an OpenHarmony device!"
    echo "====================================="
    echo "开始在鸿蒙设备上执行测试..."
    echo "测试程序：${TEST_EXEC}"
    echo "设备测试目录：${TEST_DEST_DIR}"
    echo "====================================="

    HDC_CMD='/mnt/d/hongmeng/sdk/18/toolchains/hdc.exe'

    # 1. 检查 hdc 工具是否可用
    if ! command -v $HDC_CMD &> /dev/null; then
        echo "错误：未找到 hdc 工具！请检查路径是否正确："
        echo "当前 hdc 路径：$HDC_CMD"
        return 1
    fi

    # 2. 检查设备是否连接
    $HDC_CMD list targets > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "错误：未找到连接的鸿蒙设备/模拟器！"
        echo "请先启动设备并开启调试模式，再执行测试。"
        return 1
    fi

    # 3. 获取打包后的文件路径
    LIB_PATH="${builddir}/${ARCH}-build/libaim.so"
    TEST_PATH="${builddir}/${ARCH}-build/bin/test_libaim_ohos"

    # 4. 检查本地打包文件是否存在
    if [ ! -f "${LIB_PATH}" ] || [ ! -f "${TEST_PATH}" ]; then
        echo "错误：打包文件缺失！"
        echo "libaim.so 路径：${LIB_PATH}"
        echo "测试程序路径：${TEST_PATH}"
        return 1
    fi

    # 5. 上传文件到设备
    echo "正在上传文件到设备..."
    echo "TEST_DEST_DIR=$TEST_DEST_DIR"
    echo "LYCIUM_ROOT=$LYCIUM_ROOT"
    echo "LIB_PATH=$LIB_PATH"
    $HDC_CMD shell "rm -rf ${TEST_DEST_DIR} && mkdir -p ${TEST_DEST_DIR}"
    $HDC_CMD file send "${LIB_PATH}" "${TEST_DEST_DIR}"
    $HDC_CMD file send "${TEST_PATH}" "${TEST_DEST_DIR}"
    if [ $? -ne 0 ]; then
        echo "错误：文件上传失败！"
        return 1
    fi

    $HDC_CMD shell "find ${TEST_DEST_DIR} -name 'libaim.so' -exec mv {} ${TEST_DEST_DIR}/ \;"
    $HDC_CMD shell "find ${TEST_DEST_DIR} -name '${TEST_EXEC}' -exec mv {} ${TEST_DEST_DIR}/ \;"
    # $HDC_CMD shell "rm -rf ${TEST_DEST_DIR}/${builddir} 2>/dev/null || true"

    # 6. 在设备上执行测试
    echo "正在执行测试..."
    $HDC_CMD shell "cd ${TEST_DEST_DIR} && chmod +x ${TEST_EXEC} libaim.so && export LD_LIBRARY_PATH=\$PWD && ./${TEST_EXEC}; echo EXIT_CODE:\$?" > /tmp/hdc_output.txt 2>&1
    test_ret=$(grep "EXIT_CODE:" /tmp/hdc_output.txt | cut -d: -f2 | tr -d '\r\n')
    echo "测试结果：test_ret=${test_ret}"

    # 8. 输出测试结果
    if [ $test_ret -eq 0 ]; then
        echo "====================================="
        echo "测试成功！所有用例执行通过。"
        echo "====================================="
        return 0
    else
        echo "====================================="
        echo "测试失败！退出码：${test_ret}"
        echo "====================================="
        return $test_ret
    fi
}

cleanbuild() {
    rm -rf ${PWD}/${packagename}
    rm -rf ${PWD}/${pkgname}
    rm -rf ${PWD}/${builddir}
    rm -rf ${PWD}/${builddir}-cvs
    rm -rf ${PWD}/download.log
    rm -rf ${PWD}/last_error
}
