+    subtrack->SetFrameSize(1920, 1080);
+    subtrack->SetAlignment(5); 
+
+    int clipCount = subtrack->ClipCount();
+    cout << "[SUCCESS] Subtitle loaded. Total lines (clips): " << clipCount << endl;
+
+    cout << "\n[Step 3] Testing Subtitle Rendering Engine..." << endl;
+    int testCount = min(5, clipCount);
+    
+    subtrack->SeekToIndex(0);
+    
+    for (int i = 0; i < testCount; ++i) {
+        SubtitleClipHolder clip = subtrack->GetCurrClip();
+        if (clip) {
+            cout << "\n  --- Subtitle " << i + 1 << " ---" << endl;
+            cout << "  Text: " << clip->Text() << endl;
+            
+            cout << "  Time: " << ImGuiHelper::MillisecToString(clip->StartTime()) << " -> " 
+                 << ImGuiHelper::MillisecToString(clip->StartTime() + clip->Duration()) << endl;
+
+            SubtitleImage subImage = clip->Image();
+            
+            if (subImage.Valid()) {
+                SubtitleImage::Rect dispRect = subImage.Area();
+                ImGui::ImMat vmat = subImage.Vmat();
+                cout << "  [Render SUCCESS] Generated Image Matrix:" << endl;
+                cout << "    - Canvas Position (X,Y): (" << dispRect.x << ", " << dispRect.y << ")" << endl;
+                cout << "    - Image Size (W,H): " << dispRect.w << "x" << dispRect.h << endl;
+                cout << "    - Pixel Format: " << vmat.color_format << endl;
+            } else {
+                cout << "  [Render FAILED] Could not generate image for this clip." << endl;
+            }
+        }
+        
+        subtrack->GetNextClip();
+    }
+
+    subtrack = nullptr;
+    ReleaseSubtitleLibrary();
+
+    cout << "\n========== SubtitleReader Test Finished ==========" << endl;
+    return 0;
+}
