+#include <iostream>
+#include <string>
+#include "MediaParser.h"
+#include "Snapshot.h"
+#include "Logger.h"
+
+using namespace std;
+using namespace Logger;
+using namespace MediaCore;
+
+int main(int argc, char* argv[])
+{
+    Log(INFO) << "========== SnapshotTest Start ==========" << endl;
+    if (argc < 2)
+    {
+        Log(Error) << "Wrong arguments! Usage: ./SnapshotTest <input_video>" << endl;
+        return -1;
+    }
+    string filePathName = argv[1];
+
+    GetDefaultLogger()->SetShowLevels(DEBUG);
+    MediaParser::GetLogger()->SetShowLevels(INFO);
+    Snapshot::GetLogger()->SetShowLevels(DEBUG);
+
+    Log(INFO) << "Parsing media file: " << filePathName << endl;
+
+    // 初始化解析器
+    auto parser = MediaParser::CreateInstance();
+    if (!parser->Open(filePathName)) {
+        Log(Error) << "Failed to open media file! Error: " << parser->GetError() << endl;
+        return -1;
+    }
+    Log(INFO) << "Media parsed successfully!" << endl;
+
+    // 初始化 Snapshot Generator (抽帧生成器)
+    Log(INFO) << "Step 2: Creating Snapshot Generator..." << endl;
+    auto ssgen = Snapshot::Generator::CreateInstance();
+
+    // 绑定解析器开始抽帧业务
+    if (!ssgen->Open(parser)) {
+        Log(Error) << "Failed to open Snapshot Generator!" << endl;
+        return -1;
+    }
+
+    // 5. 核心测试逻辑：提取视频信息并配置截图参数
+    auto pVidstm = ssgen->GetVideoStream();
+    if (pVidstm) {
+        Log(INFO) << "Original Video Size: " << pVidstm->width << "x" << pVidstm->height << endl;
+        
+        // 测试一：设置截图尺寸为原视频的一半
+        int snapWidth = pVidstm->width / 2;
+        int snapHeight = pVidstm->height / 2;
+        ssgen->SetSnapshotSize(snapWidth, snapHeight);
+        Log(INFO) << "Target Snapshot Size: " << snapWidth << "x" << snapHeight << endl;
+
+        // 测试二：配置截图的时间窗口和帧数 (根据原代码逻辑改造)
+        double windowSize = (double)ssgen->GetVideoDuration() / 1000.0; // 获取视频秒数
+        double windowFrames = 14.0; // 在这个时间段内均匀抽取 14 帧
+        
+        Log(INFO) << "Configuring Snap Window (Duration: " << windowSize << "s, Frames: " << windowFrames << ")" << endl;
+        
+        // 下发抽帧指令给底层引擎
+        ssgen->ConfigSnapWindow(windowSize, windowFrames);
+        
+        Log(INFO) << "Snapshot Generator configured successfully!" << endl;
+    } else {
+        Log(Error) << "No video stream found for snapshot!" << endl;
+    }
+
+    ssgen = nullptr;
+    parser = nullptr;
+
+    Log(INFO) << "========== Snapshot Test Finished ==========" << endl;
+    return 0;
+}
