+++ test_mediacore/MediaEncoderTest.cpp	2026-03-28 16:49:10.785186412 +0800
@@ -0,0 +1,241 @@
+#include <iostream>
+#include <string>
+#include <memory>
+#include <vector>
+
+#include "MediaParser.h"
+#include "MediaReader.h"
+#include "MediaEncoder.h"
+#include "Logger.h"
+#include "FFUtils.h"
+
+extern "C" {
+#include <libavutil/pixfmt.h>
+#include <libswscale/swscale.h>
+}
+
+using namespace std;
+using namespace Logger;
+using namespace MediaCore;
+
+int main(int argc, const char* argv[])
+{
+    cout << "========== MediaEncoderTest Start ==========" << endl;
+    if (argc < 3)
+    {
+        Log(Error) << "Wrong arguments!" << endl;
+        return -1;
+    }
+    
+    GetDefaultLogger()->SetShowLevels(DEBUG);
+    MediaEncoder::GetLogger()->SetShowLevels(DEBUG);
+
+    string vidEncCodec = "mpeg4";         
+    string vidEncImgFormat = "yuv420p"; 
+    
+    uint32_t outWidth{1280}, outHeight{720};
+    Ratio outFrameRate = { 60, 1 };
+    uint64_t outVidBitRate = 30*1000*1000;
+    
+    string audEncCodec = "aac";
+    uint32_t outAudChannels = 2;
+    uint32_t outSampleRate = 48000;
+    uint64_t outAudBitRate = 128*1000;
+    int64_t maxEncodeDuration = 5*1000;
+    
+    vector<MediaEncoder::Option> extraOpts;
+    bool videoOnly{true}, audioOnly{false};
+
+    MediaParser::Holder hParser = MediaParser::CreateInstance();
+    if (!hParser->Open(argv[1]))
+    {
+        Log(Error) << "FAILED to open MediaParser by file '" << argv[1] << "'! Error is '" << hParser->GetError() << "'." << endl;
+        return -1;
+    }
+    MediaInfo::Holder hInfo = hParser->GetMediaInfo();
+
+    int vIdx = hParser->GetBestVideoStreamIndex();
+    uint32_t srcW = 1280, srcH = 720; 
+    if (vIdx >= 0 && vIdx < hInfo->streams.size()) {
+        auto vStream = std::dynamic_pointer_cast<VideoStream>(hInfo->streams[vIdx]);
+        if (vStream) {
+            srcW = vStream->width; 
+            srcH = vStream->height;
+            Log(INFO) << "Source Video Resolution: " << srcW << "x" << srcH << endl;
+        } else {
+            Log(Error) << "Stream at index " << vIdx << " is not a VideoStream!" << endl;
+        }
+    }
+    outWidth = srcW;
+    outHeight = srcH;
+
+    MediaReader::Holder hVidReader, hAudReader;
+    string audioPcmFormat;
+    uint32_t audioBlockAlign{0};
+    
+    if (hParser->GetBestVideoStreamIndex() >= 0 && !audioOnly)
+    {
+        hVidReader = MediaReader::CreateVideoInstance();
+        hVidReader->EnableHwAccel(false);
+        if (!hVidReader->Open(hParser))
+        {
+            Log(Error) << "FAILED to open video MediaReader! Error is '" << hVidReader->GetError() << "'." << endl;
+            return -2;
+        }
+        
+        if (!hVidReader->ConfigVideoReader(outWidth, outHeight, IM_CF_RGBA))
+        {
+            Log(Error) << "FAILED to configure video MediaReader! Error is '" << hVidReader->GetError() << "'." << endl;
+            return -3;
+        }
+        hVidReader->Start();
+    }
+    
+    if (hParser->GetBestAudioStreamIndex() >= 0 && !videoOnly)
+    {
+        hAudReader = MediaReader::CreateInstance();
+        if (!hAudReader->Open(hParser)) 
+            return -4;
+        if (!hAudReader->ConfigAudioReader(outAudChannels, outSampleRate, "fltp")) 
+            return -5;
+        audioPcmFormat = hAudReader->GetAudioOutPcmFormat();
+        audioBlockAlign = hAudReader->GetAudioOutFrameSize();
+        hAudReader->Start();
+    }
+
+    auto hEncoder = MediaEncoder::CreateInstance();
+    if (!hEncoder->Open(argv[2])) return -6;
+
+    if (hVidReader && !hEncoder->ConfigureVideoStream(vidEncCodec, vidEncImgFormat, outWidth, outHeight, outFrameRate, outVidBitRate, &extraOpts))
+    {
+        Log(Error) << "FAILED to configure video encoder! Error is '" << hEncoder->GetError() << "'." << endl;
+        return -7;
+    }
+    
+    string audEncSmpFormat = "fltp";
+    if (hAudReader && !hEncoder->ConfigureAudioStream(audEncCodec, audEncSmpFormat, outAudChannels, outSampleRate, outAudBitRate)) return -8;
+    
+    hEncoder->Start();
+
+    SwsContext* swsCtx = nullptr;
+    if (hVidReader) {
+        swsCtx = sws_getContext(
+            outWidth, outHeight, AV_PIX_FMT_RGBA, 
+            outWidth, outHeight, AV_PIX_FMT_YUV420P, 
+            SWS_FAST_BILINEAR, nullptr, nullptr, nullptr
+        );
+    }
+
+    bool vidInputEof = hVidReader ? false : true;
+    bool audInputEof = hAudReader ? false : true;
+    int64_t audpos = 0, vidpos = 0;
+    uint32_t vidFrameCount = 0;
+    ImGui::ImMat vmat, amat;
+    
+    while (!vidInputEof || !audInputEof)
+    {
+        if ((!vidInputEof && vidpos <= audpos) || audInputEof)
+        {
+            bool eof = false;
+            vidpos = (int64_t)((double)vidFrameCount*outFrameRate.den/outFrameRate.num*1000);
+            
+            auto hVf = hVidReader->ReadVideoFrame(vidpos, eof);
+            if (hVf && !eof) 
+            {
+                if (!hVf->GetMat(vmat)) vmat.release();
+            }
+            
+            if (vmat.empty() && !eof)
+            {
+                Log(Error) << "FAILED to read video frame! Error is '" << hVidReader->GetError() << "'." << endl;
+                break;
+            }
+            
+            vidFrameCount++;
+            if (maxEncodeDuration > 0 && vidpos >= maxEncodeDuration) eof = true;
+                
+            if (!eof)
+            {
+                vmat.time_stamp = (double)vidpos/1000;
+                
+                SelfFreeAVFramePtr yuvAvfrm = AllocSelfFreeAVFramePtr();
+                yuvAvfrm->format = AV_PIX_FMT_YUV420P;
+                yuvAvfrm->width = outWidth;
+                yuvAvfrm->height = outHeight;
+                yuvAvfrm->pts = vidpos;
+
+                if (av_frame_get_buffer(yuvAvfrm.get(), 0) < 0) {
+                    Log(Error) << "FAILED to allocate physical buffer for YUV frame!" << endl;
+                    break;
+                }
+
+                // 利用 sws_scale 把 RGBA 精准映射进 YUV 的 3 个平面
+                uint8_t* srcData[4] = { (uint8_t*)vmat.data, nullptr, nullptr, nullptr };
+                int srcLinesize[4] = { (int)(outWidth * 4), 0, 0, 0 }; 
+                sws_scale(swsCtx, srcData, srcLinesize, 0, outHeight, yuvAvfrm->data, yuvAvfrm->linesize);
+
+                // 包装成原生 Holder，送给编码器！
+                auto hYuvVf = FFUtils::CreateVideoFrameFromAVFrame(yuvAvfrm, vidpos);
+
+                bool consumed = false;
+                Log(INFO) << "Pushing Video Frame to encoder at " << vidpos << " ms..." << endl;
+                if (!hEncoder->EncodeVideoFrame(hYuvVf, consumed))
+                {
+                    Log(Error) << "FAILED to encode video frame! Error is '" << hEncoder->GetError() << "'." << endl;
+                    break;
+                }
+            }
+            else
+            {
+                vmat.release();
+                bool consumed = false;
+                MediaCore::VideoFrame::Holder emptyVf = nullptr; 
+                if (!hEncoder->EncodeVideoFrame(emptyVf, consumed))
+                {
+                    Log(Error) << "FAILED to encode video EOF! Error is '" << hEncoder->GetError() << "'." << endl;
+                    break;
+                }
+                vidInputEof = true;
+            }
+        }
+        else
+        {
+            bool eof = false;
+            uint32_t readSamples = 0;
+            if (!hAudReader->ReadAudioSamples(amat, readSamples, eof) && !eof)
+            {
+                Log(Error) << "FAILED to read audio samples! Error is '" << hAudReader->GetError() << "'." << endl;
+                break;
+            }
+            audpos = amat.time_stamp*1000;
+            
+            if (maxEncodeDuration > 0 && audpos >= maxEncodeDuration) 
+                eof = true;
+                
+            if (!eof)
+            {
+                bool consumed = false;
+                if (!hEncoder->EncodeAudioSamples(amat, consumed)) break;
+            }
+            else
+            {
+                amat.release();
+                bool consumed = false;
+                if (!hEncoder->EncodeAudioSamples(amat, consumed)) break;
+                audInputEof = true;
+            }
+        }
+    }
+    
+    hEncoder->FinishEncoding();
+    hEncoder->Close();
+
+    hEncoder = nullptr;
+    hVidReader = nullptr;
+    hAudReader = nullptr;
+    hInfo = nullptr;
+    hParser = nullptr;
+    
+    cout << "\n========== MediaEncoderTest Finished ==========" << endl;
+    return 0;
+}
