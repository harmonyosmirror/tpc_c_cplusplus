+using namespace Logger;
+using namespace MediaCore;
+using namespace FM;
+
+int main(int argc, char* argv[])
+{
+    cout << "==========  SubtitleReader Test ==========" << endl;
+
+    if (argc < 2) {
+        cout << "[ERROR] Usage: ./SubtitleReaderTest <subtitle_file_path.srt>" << endl;
+        return -1;
+    }
+
+    string filePath = argv[1];
+
+    GetDefaultLogger()->SetShowLevels(DEBUG);
+    GetSubtitleTrackLogger()->SetShowLevels(VERBOSE);
