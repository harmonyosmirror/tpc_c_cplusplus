+#include <iostream>
+#include <string>
+#include "MediaParser.h"
+#include "Overview.h"
+#include "Logger.h"
+
+using namespace std;
+using namespace Logger;
+using namespace MediaCore;
+
+int main(int argc, char* argv[])
+{
+    Log(INFO) << "========== OpenHarmony Overview Test Start ==========" << endl;
+
+    if (argc < 2)
+    {
+        Log(Error) << "Wrong arguments! Usage: ./OverviewTest <input_video>" << endl;
+        return -1;
+    }
+
+    GetDefaultLogger()->SetShowLevels(DEBUG);
+    Overview::GetLogger()->SetShowLevels(DEBUG);
+
+    string filePathName = argv[1];
+
+    Log(INFO) << "Step 1: Parsing media file: " << filePathName << endl;
+
+    // 初始化解析器并开启视频关键帧搜索支持 (VIDEO_SEEK_POINTS)
+    auto parser = MediaParser::CreateInstance();
+    if (!parser->Open(filePathName)) {
+        Log(Error) << "[ERROR] Failed to open media file! Error: " << parser->GetError() << endl;
+        return -1;
+    }
+    parser->EnableParseInfo(MediaParser::VIDEO_SEEK_POINTS);
+    Log(INFO) << "[SUCCESS] Media parsed successfully!" << endl;
+
+    // 初始化 Overview 模块，设定抽取 12 张缩略图
+    uint32_t ssCount = 12;
+    Log(INFO) << "Creating Overview with " << ssCount << " snapshots..." << endl;
+    
+    auto overview = Overview::CreateInstance();
+    
+    // 调用 Open 开始底层抽帧运算
+    if (overview->Open(parser, ssCount)) {
+        Log(INFO) << "[SUCCESS] Overview generated successfully!" << endl;
+    } else {
+        Log(INFO) << "[ERROR] Failed to open Overview!" << endl;
+    }
+
+    overview = nullptr;
+    parser = nullptr;
+
