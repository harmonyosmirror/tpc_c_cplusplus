+#include <iostream>
+#include <string>
+#include "MediaParser.h"
+#include "MediaReader.h"
+#include "Logger.h"
+
+using namespace std;
+using namespace MediaCore;
+using namespace Logger;
+
+int main(int argc, char* argv[])
+{
+    Log(INFO) << "==========  MediaReaderTest ==========" << endl;
+
+    if (argc < 2) {
+        cout << "[ERROR] Usage: ./MediaReaderTest <media_file_path>" << endl;
+        return -1;
+    }
+
+    string filePath = argv[1];
+
+    GetDefaultLogger()->SetShowLevels(DEBUG);
+    MediaParser::GetLogger()->SetShowLevels(INFO);
+    MediaReader::GetDefaultLogger()->SetShowLevels(INFO);
+
+    Log(INFO) << "\nParsing media file: " << filePath << endl;
+    MediaParser::Holder hParser = MediaParser::CreateInstance();
+    if (!hParser->Open(filePath)) {
+        Log(Error) << "FAILED to open media file! Error: " << hParser->GetError() << endl;
+        return -1;
+    }
+
+    auto info = hParser->GetMediaInfo();
+    Log(INFO) << "  -> Media Duration: " << info->duration << " seconds" << endl;
+    Log(INFO) << "  -> Total Streams: " << info->streams.size() << endl;
+
+    if (hParser->HasVideo()) {
+        Log(INFO) << "\nTesting Video Reader..." << endl;
+        auto vidReader = MediaReader::CreateVideoInstance();
+        vidReader->EnableHwAccel(false);
+        vidReader->Open(hParser);
+        
+        vidReader->ConfigVideoReader((uint32_t)800, (uint32_t)450);
+        vidReader->Start();
+
+        Log(INFO) << "  -> Reading first 10 video frames..." << endl;
+        bool eof = false;
+        for (int i = 0; i < 10; ++i) {
+            auto hVf = vidReader->ReadNextVideoFrame(eof);
+            if (hVf && !eof) {
+                ImGui::ImMat vmat;
+                hVf->GetMat(vmat);
+                Log(INFO) << "     [Video] Frame " << i 
+                     << " | PTS: " << vmat.time_stamp 
+                     << " | Size: " << vmat.w << "x" << vmat.h << endl;
+                vmat.release();
+            } else {
+                Log(INFO) << "     [Video] Reached EOF or read failed." << endl;
+                break;
+            }
+        }
+        vidReader->Close();
+    }
+
+    if (hParser->HasAudio()) {
+        Log(INFO) << "\nTesting Audio Reader..." << endl;
+        auto audReader = MediaReader::CreateInstance();
+        audReader->Open(hParser);
+        
+        audReader->ConfigAudioReader((uint32_t)2, (uint32_t)44100, "flt");
+        audReader->Start();
+
+        Log(INFO) << "  -> Reading first 10 audio sample blocks..." << endl;
+        bool eof = false;
+        for (int i = 0; i < 10; ++i) {
+            ImGui::ImMat amat;
+            uint32_t readSamples = 0;
+            if (audReader->ReadAudioSamples(amat, readSamples, eof) && !eof) {
+                Log(INFO) << "     [Audio] Block " << i 
+                     << " | PTS: " << amat.time_stamp 
+                     << " | Samples: " << readSamples << endl;
+                amat.release();
+            } else {
+                Log(INFO) << "     [Audio] Reached EOF or read failed." << endl;
+                break;
+            }
+        }
+        audReader->Close();
+    }
+
+    Log(INFO) << "\n========== MediaReader Test Finished ==========" << endl;
+    return 0;
+}
