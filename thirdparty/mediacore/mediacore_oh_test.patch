@@ -0,0 +1,109 @@
+#include <iostream>
+#include <string>
+#include <vector>
+#include "MediaParser.h"
+#include "MultiTrackVideoReader.h"
+#include "VideoClip.h"
+#include "Logger.h"
+
+using namespace std;
+using namespace Logger;
+using namespace MediaCore;
+
+int main(int argc, const char* argv[])
+{
+    Log(INFO) << "========== MultiTrackVideoReaderTest (Headless) Start ==========" << endl;
+    
+    if (argc < 2)
+    {
+        Log(Error) << "Wrong arguments! Usage: ./MultiTrackVideoReaderTest <input_video>" << endl;
+        return -1;
+    }
+
+    GetDefaultLogger()->SetShowLevels(DEBUG);
+    MultiTrackVideoReader::GetLogger()->SetShowLevels(DEBUG);
+    MediaReader::GetVideoLogger()->SetShowLevels(INFO);
+
+    uint32_t outWidth{1280}, outHeight{720};
+    Ratio outFrameRate = {30, 1};
+    
+    auto mtVidReader = MultiTrackVideoReader::CreateInstance();
+    // 配置输出画面大小、帧率和数据类型
+    mtVidReader->Configure(outWidth, outHeight, outFrameRate, IM_DT_INT8);
+    mtVidReader->Start();
+
+    // 添加一条视频轨道 (Track)
+    int64_t trackId = 1;
+    if (!mtVidReader->AddTrack(trackId))
+    {
+        Log(Error) << "FAILED to add track!" << endl;
+        return -2;
+    }
+    VideoTrack::Holder hTrack = mtVidReader->GetTrackByIndex(0);
+
+    // 解析输入的视频文件
+    MediaParser::Holder hParser = MediaParser::CreateInstance();
+    if (!hParser->Open(argv[1]))
+    {
+        Log(Error) << "FAILED to open input video: " << argv[1] << endl;
+        return -3;
+    }
+
+    // 根据视频文件创建一个视频片段 (Clip)
+    int64_t clipId = 100;
+    int64_t mediaDuration = (int64_t)(hParser->GetMediaInfo()->duration * 1000); // 毫秒
+    
+    Log(INFO) << "Creating Video Clip from input file. Duration: " << mediaDuration << " ms" << endl;
+    
+    auto hClip = VideoClip::CreateVideoInstance(
+        clipId, 
+        hParser, 
+        mtVidReader->GetSharedSettings(),
+        0,              // 放置在时间线的起始位置 (0ms)
+        mediaDuration,  // 截取整个视频的长度
+        0,              // 视频文件自身的起始偏移
+        mediaDuration,  // 视频文件自身的结束偏移
+        0,              // 当前播放指针的相对位置
+        true            // 正向播放
+    );
+
+    // 把片段放进轨道里
+    hTrack->InsertClip(hClip);
+    
+    // 刷新多轨道引擎，让它内部构建渲染树
+    mtVidReader->Refresh();
+
+    int64_t playPos = 0;
+    uint32_t frameCount = 0;
+    uint32_t maxTestFrames = 100;
+
+    while (playPos <= mediaDuration && frameCount < maxTestFrames)
+    {
+        vector<CorrelativeFrame> frames;
+        // 核心接口：向引擎请求 playPos 这个时间点的混合画面
+        bool readRes = mtVidReader->ReadVideoFrameByPosEx(playPos, frames, true, false);
+
+        if (readRes && !frames.empty())
+        {
+            ImGui::ImMat vmat = frames[0].frame;
+            if (!vmat.empty())
+            {
+                Log(INFO) << ">> Read Frame #" << frameCount 
+                     << " | Timeline Pos: " << playPos << " ms"
+                     << " | PTS: " << vmat.time_stamp << " s"
+                     << " | Format: " << vmat.color_format 
+                     << " | Size: " << vmat.w << "x" << vmat.h << endl;
+            }
+        }
+        frameCount++;
+        playPos = (int64_t)((double)frameCount * outFrameRate.den / outFrameRate.num * 1000);
+    }
+
+    mtVidReader = nullptr;
+    hTrack = nullptr;
+    hClip = nullptr;
+    hParser = nullptr;
+
+    Log(INFO) << "========== MultiTrackVideoReaderTest Finished ==========" << endl;
+    return 0;
+}
