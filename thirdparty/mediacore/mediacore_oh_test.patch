+#include <iostream>
+#include <string>
+#include <vector>
+#include "MediaParser.h"
+#include "MultiTrackAudioReader.h"
+#include "Logger.h"
+
+using namespace std;
+using namespace Logger;
+using namespace MediaCore;
+
+int main(int argc, const char* argv[])
+{
+    Log(INFO) << "========== MultiTrackAudioReaderTest (Headless) Start ==========" << endl;
+
+    if (argc < 2)
+    {
+        Log(Error) << "Wrong arguments! Usage: ./MultiTrackAudioReaderTest <input_audio_or_video>" << endl;
+        return -1;
+    }
+
+    GetDefaultLogger()->SetShowLevels(DEBUG);
+    MultiTrackAudioReader::GetLogger()->SetShowLevels(DEBUG);
+    MediaReader::GetDefaultLogger()->SetShowLevels(INFO);
+
+    // 2. 创建并配置多轨道音频混合器
+    uint32_t outChannels = 2;       // 双声道立体声
+    uint32_t outSampleRate = 44100; // 44.1kHz 采样率
+    string outPcmFormat = "fltp";   
+
+    auto mtAudReader = MultiTrackAudioReader::CreateInstance();
+    mtAudReader->Configure(outChannels, outSampleRate, outPcmFormat);
+    mtAudReader->Start();
+
+    // 3. 添加一条音频轨道 (Track)
+    int64_t trackId = 1;
+    if (!mtAudReader->AddTrack(trackId))
+    {
+        Log(Error) << "FAILED to add audio track!" << endl;
+        return -2;
+    }
+    AudioTrack::Holder hTrack = mtAudReader->GetTrackByIndex(0);
+
+    // 4. 解析输入的媒体文件
+    MediaParser::Holder hParser = MediaParser::CreateInstance();
+    if (!hParser->Open(argv[1]))
+    {
+        Log(Error) << "FAILED to open input file: " << argv[1] << endl;
+        return -3;
+    }
+
+    // 5. 将解析出来的音频流作为 Clip 插入轨道
+    int64_t clipId = 100;
+    int64_t mediaDuration = (int64_t)(hParser->GetMediaInfo()->duration * 1000); // 毫秒
+
+    Log(INFO) << "Adding Audio Clip from file. Duration: " << mediaDuration << " ms" << endl;
+
+    // 参数：clipId, 解析器, 轨道起始时间(0), 轨道结束时间(总长), 文件内部起始偏移(0), 文件内部结束偏移(总长)
+    hTrack->AddNewClip(clipId, hParser, 0, mediaDuration, 0, mediaDuration);
+
+    // 6. 刷新混合器，构建内部混音树
+    mtAudReader->Refresh();
+
+    bool eof = false;
+    uint32_t frameCount = 0;
+    uint32_t maxTestFrames = 100; 
+
+    while (!eof && frameCount < maxTestFrames)
+    {
+        ImGui::ImMat amat;
+        
+        if (!mtAudReader->ReadAudioSamples(amat, eof))
+        {
+            Log(Error) << "Failed to read audio samples! Internal error." << endl;
+            break;
+        }
+
+        if (!amat.empty())
+        {
+            uint32_t dataSize = amat.total() * amat.elemsize;
+            Log(INFO) << ">> Read Audio Pkt #" << frameCount 
+                 << " | PTS: " << amat.time_stamp << " s"
+                 << " | Size: " << dataSize << " bytes" 
+                 << endl;
+            frameCount++;
+        }
+    }
+
+    mtAudReader = nullptr;
+    hTrack = nullptr;
+    hParser = nullptr;
+
+    Log(INFO) << "========== MultiTrackAudioReaderTest Finished ==========" << endl;
+    return 0;
+}
