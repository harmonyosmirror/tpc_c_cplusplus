@@ -0,0 +1,48 @@
+#!/bin/sh
+
+VIDEO_NAME="test.mp4"
+SUBTITLE_NAME="test.srt"
+
+BASE_LIB_DIR="${LYCIUM_ROOT}/usr"
+FFMPEG_PATH="${LYCIUM_ROOT}/usr/FFmpeg/${ARCH}/bin/ffmpeg"
+AUTO_LIB_DIRS=$(find "$BASE_LIB_DIR" -type d -name "arm64-v8a" -exec find {} \( -type f -o -type l \) -name "*.so*" \; | sed 's|/[^/]*$||' | sort -u | paste -sd ":" -)
+export LD_LIBRARY_PATH="${AUTO_LIB_DIRS}"
+
+if [ ! -x "${FFMPEG_PATH}" ]; then
+    echo "[Error] FFmpeg executable not found: ${FFMPEG_PATH}"
+    exit 1
+fi
+
+# 生成测试视频 (加入 1000Hz 测试音，使用 mpeg4 视频软编 + aac 音频软编)
+echo "1.Generating a test video and audio now. (mpeg4 + aac): ${VIDEO_NAME} ..."
+"${FFMPEG_PATH}" -y -f lavfi -i testsrc=duration=5:size=1280x720:rate=60 \
+    -f lavfi -i sine=frequency=1000:duration=5:sample_rate=48000 \
+    -c:v mpeg4 -pix_fmt yuv420p \
+    -c:a aac -b:a 128k \
+    ${VIDEO_NAME} > /dev/null 2>&1
+
+if [ $? -eq 0 ]; then
+    echo "  -> [Success] The video has been generated!"
+else
+    echo "  -> [Failed] An error occurred during video generation. Please check the FFmpeg and dynamic library dependencies."
+    exit 1
+fi
+
+# 生成测试字幕 (.srt 格式)
+echo "2.Generating test subtitles now.: ${SUBTITLE_NAME} ..."
+cat > ${SUBTITLE_NAME} << EOF
+1
+00:00:00,500 --> 00:00:02,000
+For testing only....
+Hello, OpenHarmony!
+
+2
+00:00:02,500 --> 00:00:04,500
+This is a generated test subtitle.
+SubtitleReader For testing only
+EOF
+
+echo "  -> [成功] 字幕已生成！"
+echo "======================================"
+ls -lh ${VIDEO_NAME} ${SUBTITLE_NAME}
