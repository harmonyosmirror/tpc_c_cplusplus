pkgname=mediacore
pkgver=4c4386837d596368e483d6c2a2f09cd37788af7f
pkgrel=0
pkgdesc=""
url="https://github.com/opencodewin/MediaEditor"
archs=("armeabi-v7a" "arm64-v8a" "x86_64")
license=("LGPL")
depends=("FFmpeg" "libass" "fontconfig" "freetype2_2_13_0" "libxml2" "harfbuzz" "fribidi" "glm" "zlib" "openssl_3.4.3" "libsdl")
makedepends=()

source="https://github.com/opencodewin/MediaEditor/archive/${pkgver}.tar.gz"

autounpack=true
downloadpackage=true
buildtools="cmake"

builddir=mediacore-$pkgver
packagename=$builddir.tar.gz
buildlog=build_${pkgname}.log
patchflag=true

prepare() {
     if [ "$patchflag" == "true" ];then
        mv "MediaEditor-${pkgver}" "${builddir}"
        
        patch -d "${builddir}/MediaCore" -p0 --batch < "$PWD/mediacore_oh_test.patch" >> "$buildlog" 2>&1
        patch -d "${builddir}" -p1 --batch < "$PWD/mediacore_oh_patch.patch" >> "$buildlog" 2>&1
        patchflag=false
    fi
}

build() {
    local LOCAL_LDFLAGS="${LDFLAGS} -Wl,-z,relro,-z,now -Wl,--disable-new-dtags -s"

    cd "${builddir}/MediaCore"

    OPENSSL_LIB_PATH="${LYCIUM_ROOT}/usr/openssl_3.4.3/${ARCH}/lib"
    if [ "$ARCH" == "x86_64" ]; then
        OPENSSL_LIB_PATH="${LYCIUM_ROOT}/usr/openssl_3.4.3/${ARCH}/lib64"
    fi
    
    _LDFLAGS="-L${LYCIUM_ROOT}/usr/fontconfig/${ARCH}/lib \
              -L${LYCIUM_ROOT}/usr/freetype2_2_13_0/${ARCH}/lib \
              -L${LYCIUM_ROOT}/usr/libsdl/${ARCH}/lib \
              -L${OPENSSL_LIB_PATH}\
              -L${LYCIUM_ROOT}/usr/fribidi/${ARCH}/lib \
              -L${LYCIUM_ROOT}/usr/harfbuzz/${ARCH}/lib \
              -lfribidi -lharfbuzz"
    
    PKG_CONFIG_PATH="${pkgconfigpath}" \
    ${OHOS_SDK}/native/build-tools/cmake/bin/cmake "$@" \
        -B"$ARCH-build" -S./ \
        -DIMGUI_SRC_PATH=../imgui \
        -DIMGUI_STATIC=ON \
        -DBaseUtils_STATIC=ON \
        -DImMaskCreator_STATIC=ON \
        -DCMAKE_DISABLE_FIND_PACKAGE_OpenMP=TRUE \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY \
        -DCMAKE_C_FLAGS="-fsigned-char" \
        -DCMAKE_CXX_FLAGS="-fsigned-char" \
        -DCMAKE_C_FLAGS_RELEASE="-O3 -fstack-protector-strong -fPIC -DNDEBUG" \
        -DCMAKE_CXX_FLAGS_RELEASE="-O3 -fstack-protector-strong -fPIC -DNDEBUG" \
        -DCMAKE_SHARED_LINKER_FLAGS="${LOCAL_LDFLAGS} $_LDFLAGS -lSDL2 -lcrypto -lssl -lz" \
        -DCMAKE_EXE_LINKER_FLAGS="${LOCAL_LDFLAGS} $_LDFLAGS -lSDL2 -lcrypto -lssl -lz" \
        >> "$buildlog" 2>&1

    $MAKE -C "$ARCH-build" >> "$buildlog" 2>&1
    local ret=$?
    if [ $ret -ne 0 ]; then
        tail -n 200 "$buildlog"
    fi
    cd $OLDPWD
    return $ret
}

package() {
    cd "${builddir}/MediaCore"

    INSTALL_DIR="${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}"
    mkdir -p "${INSTALL_DIR}/lib" "${INSTALL_DIR}/include"

    cp -a ${ARCH}-build/libMediaCore.so* "${INSTALL_DIR}/lib/"
    cp -a include/* "${INSTALL_DIR}/include/"

    cd $OLDPWD
}

check() {
    echo "The test must be on an OpenHarmony device!"
}

cleanbuild() {
    rm -rf "${PWD}/${builddir}"
    rm -f "${buildlog}"
}