pkgname=glslang
pkgver=15.0.0
pkgrel=0
pkgdesc="Khronos GLSL/ESSL reference validator and GLSL to SPIR-V compiler"
url="https://github.com/KhronosGroup/glslang"
archs=("armeabi-v7a" "arm64-v8a" "x86_64")
license=("BSD-3-Clause" "Apache-2.0")
depends=()
makedepends=("cmake" "python3")

source="https://github.com/KhronosGroup/glslang/archive/refs/tags/${pkgver}.tar.gz"

downloadpackage=true
autounpack=true
buildtools="cmake"

builddir=${pkgname}-${pkgver}
packagename=${pkgname}-${pkgver}.tar.gz

prepare() {
    mkdir -p ${builddir}/${ARCH}-build
}

build() {
    # $@ is populated by lycium with the standard cmake args:
    #   -DCMAKE_BUILD_TYPE=Release
    #   -DCMAKE_TOOLCHAIN_FILE=${OHOS_SDK}/native/build/cmake/ohos.toolchain.cmake
    #   -DCMAKE_INSTALL_PREFIX=${LYCIUM_ROOT}/usr/glslang/${ARCH}/
    #   -DOHOS_ARCH=${ARCH}
    cd ${builddir}/${ARCH}-build
    cmake "$@" \
        -DENABLE_HLSL=OFF \
        -DENABLE_OPT=OFF \
        -DENABLE_GLSLANG_BINARIES=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DGLSLANG_TESTS=OFF \
        -DALLOW_EXTERNAL_SPIRV_TOOLS=OFF \
        -DCMAKE_CXX_STANDARD=17 \
        -DCMAKE_SKIP_RPATH=ON \
        .. >> $buildlog 2>&1
    make -j$(nproc) >> $buildlog 2>&1
    ret=$?
    cd $OLDPWD
    return $ret
}

package() {
    cd ${builddir}/${ARCH}-build
    make install >> $buildlog 2>&1
    cd $OLDPWD
}

check() {
    echo "glslang is a build-time SPIR-V compiler; runtime tests require integration with libplacebo."
    echo "Verify by building libplacebo with -Dglslang=enabled and checking meson setup summary."
}

cleanbuild() {
    rm -rf ${PWD}/${builddir} ${PWD}/${pkgname}-*-build
}
