pkgname=glu
pkgver=9.0.3
pkgrel=0
pkgdesc="Mesa OpenGL Utility Library (GLU). Provides tessellation (gluTess*), mipmap, quadric and NURBS functions. Required by Coin3D for 3D text rendering (SoText3) and complex polygon tessellation."
url="https://gitlab.freedesktop.org/mesa/glu"
archs=("armeabi-v7a" "arm64-v8a" "x86_64")
license=("SGI-B-1.1" "SGI-B-2.0" "MIT")
depends=()
makedepends=()

source="https://gitlab.freedesktop.org/mesa/glu/-/archive/glu-9.0.3/glu-glu-9.0.3.tar.gz"

autounpack=true
downloadpackage=true
buildtools="cmake"

builddir=glu-glu-${pkgver}
packagename=glu-glu-${pkgver}.tar.gz
patchflag=true

source envset.sh
host=

prepare() {
    mkdir -p $builddir/$ARCH-build
    if $patchflag
    then
        cd $builddir
        patch -p1 < ../glu_ohos_cmake.patch
        patchflag=false
        cd $OLDPWD
    fi
}

build() {
    cd $builddir

    ${OHOS_SDK}/native/build-tools/cmake/bin/cmake "$@" \
        -DOHOS_ARCH=$ARCH \
        -DOHOS_SDK=${OHOS_SDK} \
        -DCMAKE_C_FLAGS="-Wno-unused-command-line-argument" \
        -B$ARCH-build -S./ -L > $buildlog 2>&1
    $MAKE -C $ARCH-build >> $buildlog 2>&1
    ret=$?
    cd $OLDPWD
    return $ret
}

package() {
    local INSTALL_PREFIX=$LYCIUM_ROOT/usr/$pkgname/$ARCH
    mkdir -p $INSTALL_PREFIX/lib $INSTALL_PREFIX/include/GL
    cp $builddir/$ARCH-build/libGLU.so $INSTALL_PREFIX/lib/libGLU.so
    cp $builddir/include/GL/glu.h $INSTALL_PREFIX/include/GL/glu.h
}

check() {
    echo "The test must be on an OpenHarmony device!"
}

cleanbuild() {
    rm -rf ${PWD}/$builddir
}
