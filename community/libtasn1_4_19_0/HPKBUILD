pkgname=libtasn1_4_19_0
pkgver=4.19.0
pkgrel=0
pkgdesc="libtasn1 4.19.0 (isolated pkgname for GnuTLS 3.8.x / Samba toolchain)."
url="https://ftp.gnu.org/gnu/libtasn1"
archs=("armeabi-v7a" "arm64-v8a")
license=("LGPL-2.1-or-later")
depends=()
makedepends=()

source="https://ftp.gnu.org/gnu/libtasn1/libtasn1-${pkgver}.tar.gz"

downloadpackage=true
autounpack=true
buildtools="configure"

builddir=libtasn1-${pkgver}
packagename=${builddir}.tar.gz

source envset.sh
host=

prepare() {
    mkdir -p "${builddir}/${ARCH}-build"
    if [ "${ARCH}" == "armeabi-v7a" ]; then
        setarm32ENV
        host=arm-linux
    elif [ "${ARCH}" == "arm64-v8a" ]; then
        setarm64ENV
        host=aarch64-linux
    else
        echo "${ARCH} not support"
        return 1
    fi
    export CFLAGS="${CFLAGS:-} -Wno-error=unused-command-line-argument"
    export CXXFLAGS="${CXXFLAGS:-} -Wno-error=unused-command-line-argument"

    return 0
}

build() {
    cd "${builddir}/${ARCH}-build"
    PKG_CONFIG_LIBDIR="${pkgconfigpath}" \
        ../configure "$@" \
        --host="${host}" \
        --disable-doc \
        --disable-gtk-doc \
        >> "${buildlog}" 2>&1
    $MAKE >> "${buildlog}" 2>&1
    ret=$?
    cd "${OLDPWD}"
    return $ret
}

package() {
    cd "${builddir}/${ARCH}-build"
    $MAKE install >> "${buildlog}" 2>&1
    ret=$?
    cd "${OLDPWD}"
    unset host

    if [ "${ARCH}" == "armeabi-v7a" ]; then
        unsetarm32ENV
    elif [ "${ARCH}" == "arm64-v8a" ]; then
        unsetarm64ENV
    fi

    return $ret
}

check() {
    echo "The test must be on an OpenHarmony device!"
    return 0
}

cleanbuild() {
    rm -rf "${PWD}/${builddir}"
}
