pkgname=libpng
pkgver=v1.6.39
pkgrel=0
url="https://sourceforge.net/projects/libpng/files/libpng16/"
archs=("armeabi-v7a" "arm64-v8a" "x86_64")
license=("PNG Reference Library License version 2")
depends=()
makedepends=()
install=

# 受网络影响可能存在下载失败的情况，现使用gitee镜像可以与官方仓库保持同步
source="https://gitee.com/mirrors/$pkgname/repository/archive/$pkgver.zip"

autounpack=true
downloadpackage=true
buildtools="configure"

builddir=$pkgname-${pkgver}
packagename=$builddir.zip

# 与 apng-drawable/download_libpng_and_apply_apng_patch.sh一致：下载 SourceForge 的 APNG 补丁并以 patch -p0 应用
apng_patchflag=true

source envset.sh
host=

prepare() {
    if [ "$apng_patchflag" == true ]
    then
        LIBPNG_VERSION="${pkgver#v}"
        LIBPNG_VERSION_MAJOR=${LIBPNG_VERSION%%.*}
        MAJOR_MINOR=${LIBPNG_VERSION%.*}
        LIBPNG_VERSION_MINOR=${MAJOR_MINOR#*.}
        PATCH_URL="https://download.sourceforge.net/libpng-apng/libpng${LIBPNG_VERSION_MAJOR}${LIBPNG_VERSION_MINOR}/${LIBPNG_VERSION}/libpng-${LIBPNG_VERSION}-apng.patch.gz"
        PATCH_GZ=`pwd`/libpng-${LIBPNG_VERSION}-apng.patch.gz
        PATCH_FILE=`pwd`/libpng-${LIBPNG_VERSION}-apng.patch
        curl -L -f -o "$PATCH_GZ" "$PATCH_URL" || exit 1
        gzip -d -f "$PATCH_GZ"
        # 补丁内路径为 libpng-${LIBPNG_VERSION}/...，与 gitee 解压目录名 libpng-${pkgver} 不一致时通过临时符号链接对齐
        ln -sfn "$builddir" "libpng-${LIBPNG_VERSION}"
        patch -p0 < "$PATCH_FILE" || { rm -f "libpng-${LIBPNG_VERSION}"; exit 1; }
        rm -f "libpng-${LIBPNG_VERSION}"
        if [ -f "$builddir/scripts/pnglibconf.h.prebuilt" ]
        then
            cp -f "$builddir/scripts/pnglibconf.h.prebuilt" "$builddir/pnglibconf.h"
        fi
        rm -f "$PATCH_FILE"
        apng_patchflag=false
    fi
    mkdir -p $builddir/$ARCH-build
    if [ $ARCH == "armeabi-v7a" ]
    then
        setarm32ENV
        host=arm-linux
    fi
    if [ $ARCH == "arm64-v8a" ]
    then
        setarm64ENV
        host=aarch64-linux
    fi
    if [ $ARCH == "x86_64" ]
    then
        setx86_64ENV
        host=x86_64-linux
    fi
}

build() {
    cd $builddir/$ARCH-build
    ../configure "$@" --host=$host --enable-shared --enable-static > `pwd`/build.log 2>&1
    ret=-1
    if [ $LYCIUM_BUILD_OS == "CYGWI" ]
    then
        make libpng16.la -j4 >> `pwd`/build.log 2>&1
        ret=$?
    else
        make -j4 >> `pwd`/build.log 2>&1
        ret=$?
    fi
    cd $OLDPWD
    return $ret
}

package() {
    cd $builddir/$ARCH-build
    ret=-1
    if [ $LYCIUM_BUILD_OS == "CYGWI" ]
    then   
        make install-libLTLIBRARIES >> `pwd`/build.log 2>&1
        make install-library-links >> `pwd`/build.log 2>&1
        make install-pkgincludeHEADERS >> `pwd`/build.log 2>&1
        make install-header-links >> `pwd`/build.log 2>&1
        make install-pkgconfigDATA >> `pwd`/build.log 2>&1
        ret=$?
    else
        make install >> `pwd`/build.log 2>&1
        ret=$?
    fi
    cd $OLDPWD
    return $ret
}

check() {
    cd $builddir/$ARCH-build
    make pngtest pngunknown pngstest pngvalid pngimage pngcp timepng >> `pwd`/build.log 2>&1
    sed -i '/.*check-TESTS: $(check_PROGRAMS)/c\check-TESTS: #$(check_PROGRAMS)' Makefile
    cd $OLDPWD
    if [ $ARCH == "armeabi-v7a" ]
    then
        unsetarm32ENV
    fi
    if [ $ARCH == "arm64-v8a" ]
    then
        unsetarm64ENV
    fi
    if [ $ARCH == "x86_64" ]
    then
        unsetx86_64ENV
    fi
    unset host
    echo "The test must be on an OpenHarmony device!"
    # test CMD
    # make check-TESTS
}

# 清理环境
cleanbuild(){
    rm -rf ${PWD}/$builddir #${PWD}/$packagename
    rm -f ${PWD}/libpng-${pkgver#v}
}
