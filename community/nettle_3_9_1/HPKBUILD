pkgname=nettle_3_9_1
pkgver=3.9.1
pkgrel=0
pkgdesc="Nettle 3.9.1 cryptographic library (isolated pkgname for GnuTLS 3.8.x)."
url="https://ftp.gnu.org/gnu/nettle"
archs=("armeabi-v7a" "arm64-v8a")
license=("LGPL-3.0-or-later")
depends=("gmp")
makedepends=()

source="https://ftp.gnu.org/gnu/nettle/nettle-${pkgver}.tar.gz"

downloadpackage=true
autounpack=true
buildtools="configure"

builddir=nettle-${pkgver}
packagename=${builddir}.tar.gz

source envset.sh
host=

prepare() {
    mkdir -p "${builddir}/${ARCH}-build"
    if [ "${ARCH}" == "armeabi-v7a" ]; then
        setarm32ENV
        host=arm-linux
    elif [ "${ARCH}" == "arm64-v8a" ]; then
        setarm64ENV
        host=aarch64-linux
    else
        echo "${ARCH} not support"
        return 1
    fi

    return 0
}

build() {
    cd "${builddir}/${ARCH}-build"
    ../configure "$@" \
        --host="${host}" \
        --enable-public-key \
        --enable-shared \
        > "${buildlog}" 2>&1
    ret=$?
    if [ $ret -ne 0 ]; then
        cd "${OLDPWD}"
        return $ret
    fi

    $MAKE >> "${buildlog}" 2>&1
    ret=$?
    cd "${OLDPWD}"
    return $ret
}

package() {
    cd "${builddir}/${ARCH}-build"
    $MAKE install >> "${buildlog}" 2>&1
    ret=$?
    cd "${OLDPWD}"
    unset host

    if [ "${ARCH}" == "armeabi-v7a" ]; then
        unsetarm32ENV
    elif [ "${ARCH}" == "arm64-v8a" ]; then
        unsetarm64ENV
    fi

    return $ret
}

check() {
    if [ "${ARCH}" == "armeabi-v7a" ]; then
        unsetarm32ENV
    elif [ "${ARCH}" == "arm64-v8a" ]; then
        unsetarm64ENV
    else
        return 1
    fi

    echo "The test must be on an OpenHarmony device!"
    return 0
}

cleanbuild() {
    rm -rf "${PWD}/${builddir}"
}
