pkgname=libsmb2
pkgver=6.2
pkgrel=0
pkgdesc="libsmb2 is a client implementation of the SMB2/3 protocol for accessing remote filesystems."
url="https://github.com/sahlberg/libsmb2"
archs=("armeabi-v7a" "arm64-v8a" "x86_64")
license=("LGPL-2.1-or-later")
depends=()
makedepends=()

source="https://github.com/sahlberg/libsmb2/archive/refs/tags/libsmb2-${pkgver}.tar.gz"

downloadpackage=true
autounpack=true
buildtools="cmake"

# GitHub tarballs extract as libsmb2-libsmb2-${pkgver}
builddir=$pkgname-libsmb2-${pkgver}
packagename=$builddir.tar.gz

# 为编译设置环境，如设置环境变量，创建编译目录等
prepare() {
    mkdir -p $builddir/$ARCH-build
}

build() {
    cd $builddir
    PKG_CONFIG_LIBDIR="${pkgconfigpath}" ${OHOS_SDK}/native/build-tools/cmake/bin/cmake "$@" \
        -DENABLE_LIBKRB5=OFF \
        -DENABLE_GSSAPI=OFF \
        -B$ARCH-build -S./ -L >> $buildlog 2>&1
    if [ $? -ne 0 ]; then
        cd $OLDPWD
        return 1
    fi
    $MAKE VERBOSE=1 -C $ARCH-build >> $buildlog 2>&1
    ret=$?
    cd $OLDPWD
    return $ret
}

# 打包安装
package() {
    cd $builddir
    $MAKE VERBOSE=1 -C $ARCH-build install >> $buildlog 2>&1
    ret=$?
    cd $OLDPWD
    return $ret
}

# 进行测试的准备和说明
check() {
    echo "The test must be on an OpenHarmony device!"
}

# 清理环境
cleanbuild() {
    rm -rf ${PWD}/$builddir
}
