source HPKBUILD > /dev/null 2>&1
logfile=${LYCIUM_THIRDPARTY_ROOT}/${pkgname}/${pkgname}_${ARCH}_${OHOS_SDK_VER}_test.log

openharmonycheck() {
    libdir="${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}/lib"
    incdir="${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}/include"

    echo "=== monocypher artifact check (${ARCH}) ===" > "${logfile}"
    echo "LYCIUM_ROOT: ${LYCIUM_ROOT}" >> "${logfile}"

    for artifact in \
        "${libdir}/libmonocypher.so" \
        "${incdir}/monocypher.h" \
        "${incdir}/optional/monocypher-ed25519.h"; do
        if [ ! -f "${artifact}" ]; then
            echo "FAIL: missing artifact: ${artifact}" >> "${logfile}"
            return 1
        fi
        echo "PASS: found artifact: ${artifact}" >> "${logfile}"
    done

    echo "PASS: monocypher library artifacts present." >> "${logfile}"
    return 0
}
